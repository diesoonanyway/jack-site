---
import { getSpotifyEpisodeId } from '../lib/spotify';
import { getYouTubeVideoId } from '../lib/youtube';

interface Props {
  title: string;
  description?: string;
  date: Date;
  dateLocale: string;
  href: string;
  visual?: string;
  youtubeUrl?: string;
  spotifyUrl?: string;
  featured?: boolean;
  mobileOnly?: boolean;
}

const {
  title,
  description,
  date,
  dateLocale,
  href,
  visual,
  youtubeUrl,
  spotifyUrl,
  featured = false,
  mobileOnly = false,
} = Astro.props;

const youtubeId = getYouTubeVideoId(youtubeUrl);
const youtubeThumbnail = youtubeId
  ? `https://i.ytimg.com/vi/${youtubeId}/mqdefault.jpg`
  : null;
const spotifyId = youtubeId
  ? null
  : getSpotifyEpisodeId(spotifyUrl);
---

<article class:list={[
  'media-rail-item',
  'story-rail-item',
  {
    'featured-rail-item': featured,
    'mobile-featured-card': mobileOnly,
  },
]}>
  <div class="story-card-labels">
    {featured && <span class="featured-badge">Featured</span>}
  </div>

  {youtubeThumbnail ? (
    <a
      class="story-rail-visual story-rail-youtube"
      href={href}
      tabindex="-1"
      aria-hidden="true"
    >
      <img
        src={youtubeThumbnail}
        alt=""
        loading={featured ? 'eager' : 'lazy'}
      />
      <span class="play-cue play-cue--small" aria-hidden="true">▶</span>
    </a>
  ) : spotifyId ? (
    <div class="story-rail-spotify">
      <iframe
        src={`https://open.spotify.com/embed/episode/${spotifyId}`}
        title={dateLocale.startsWith('ko')
          ? `${title} Spotify 재생기`
          : `${title} Spotify player`}
        width="100%"
        height="152"
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      ></iframe>
    </div>
  ) : visual ? (
    <a
      class="story-rail-visual"
      href={href}
      tabindex="-1"
      aria-hidden="true"
    >
      <img src={visual} alt="" loading={featured ? 'eager' : 'lazy'} />
    </a>
  ) : null}

  <h3 class="media-card-title">
    <a class="media-card-link" href={href}>{title}</a>
  </h3>
  {description && <p class="story-card-description">{description}</p>}
  <time datetime={date.toISOString()}>
    {date.toLocaleDateString(dateLocale, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })}
  </time>
</article>
