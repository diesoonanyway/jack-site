---
interface Props {
  section: 'what-i-feel' | 'what-i-learn';
  slug: string;
  lang: 'en' | 'ko';
}

const { section, slug, lang } = Astro.props;
const isKorean = lang === 'ko';
---

<section
  class="comments"
  data-comments
  data-section={section}
  data-slug={slug}
  data-lang={lang}
  aria-labelledby={`comments-title-${section}-${slug}`}
>
  <div class="comments-heading">
    <h2 id={`comments-title-${section}-${slug}`}>{isKorean ? '댓글' : 'Comments'}</h2>
    <p>{isKorean ? 'Google 계정 이름으로 댓글을 남길 수 있습니다.' : 'Join the conversation with your Google account name.'}</p>
  </div>

  <p class="comments-status" data-comments-status role="status" aria-live="polite">
    {isKorean ? '댓글을 불러오는 중…' : 'Loading comments…'}
  </p>

  <div class="comments-auth" data-comments-auth hidden>
    <button type="button" class="comments-button comments-button--primary" data-comments-login>
      {isKorean ? 'Google로 로그인' : 'Continue with Google'}
    </button>
    <div class="comments-google-button" data-comments-google-button hidden></div>
    <p class="comments-privacy-note">
      {isKorean
        ? '로그인하면 Google이 인증에 필요한 정보를 처리합니다. 이메일과 Google 계정 ID는 공개되지 않습니다.'
        : 'Google processes the information needed to sign you in. Your email and Google account ID are never public.'}
    </p>
  </div>

  <div class="comments-account" data-comments-account hidden>
    <p>
      <span data-comments-account-name></span>
      <a href="/admin/comments/" data-comments-admin hidden>{isKorean ? '관리' : 'Manage'}</a>
    </p>
    <button type="button" class="comments-text-button" data-comments-logout>
      {isKorean ? '로그아웃' : 'Sign out'}
    </button>
  </div>

  <form class="comments-form" data-comments-form hidden>
    <label for={`comment-body-${section}-${slug}`}>{isKorean ? '댓글 작성' : 'Write a comment'}</label>
    <textarea
      id={`comment-body-${section}-${slug}`}
      name="body"
      rows="5"
      maxlength="2000"
      required
      data-comments-body
    ></textarea>
    <div class="comments-form-footer">
      <span data-comments-count>0 / 2000</span>
      <button type="submit" class="comments-button comments-button--primary" data-comments-submit>
        {isKorean ? '댓글 등록' : 'Post comment'}
      </button>
    </div>
  </form>

  <p class="comments-blocked" data-comments-blocked hidden>
    {isKorean ? '이 계정은 새 댓글을 작성할 수 없습니다.' : 'This account cannot post new comments.'}
  </p>

  <ol class="comments-list" data-comments-list></ol>
  <p class="comments-empty" data-comments-empty hidden>
    {isKorean ? '아직 댓글이 없습니다. 첫 댓글을 남겨 보세요.' : 'No comments yet. You can start the conversation.'}
  </p>
  <button type="button" class="comments-button comments-button--secondary comments-more" data-comments-more hidden>
    {isKorean ? '댓글 더 보기' : 'Load more comments'}
  </button>
</section>

<script>
  type GoogleCredentialResponse = { credential?: string };
  type GoogleNotification = {
    isNotDisplayed: () => boolean;
    isSkippedMoment: () => boolean;
  };
  type GoogleIdentity = {
    accounts: {
      id: {
        initialize: (options: { client_id: string; callback: (response: GoogleCredentialResponse) => void }) => void;
        prompt: (callback?: (notification: GoogleNotification) => void) => void;
        renderButton: (element: HTMLElement, options: Record<string, unknown>) => void;
        disableAutoSelect: () => void;
      };
    };
  };
  type GoogleWindow = Window & {
    google?: GoogleIdentity;
    __ifitallendsGoogleScript?: Promise<GoogleIdentity>;
  };

  type CommentItem = {
    id: number;
    author: string;
    body: string;
    createdAt: number;
  };
  type SessionState = {
    authenticated: boolean;
    user?: { name: string };
    admin?: boolean;
    blocked?: boolean;
    csrfToken?: string;
  };

  const googleWindow = window as GoogleWindow;

  function loadGoogleIdentity(): Promise<GoogleIdentity> {
    if (googleWindow.google) return Promise.resolve(googleWindow.google);
    if (googleWindow.__ifitallendsGoogleScript) return googleWindow.__ifitallendsGoogleScript;

    googleWindow.__ifitallendsGoogleScript = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://accounts.google.com/gsi/client';
      script.async = true;
      script.defer = true;
      script.addEventListener('load', () => {
        if (googleWindow.google) resolve(googleWindow.google);
        else reject(new Error('Google Identity Services did not initialize.'));
      }, { once: true });
      script.addEventListener('error', () => reject(new Error('Google Identity Services could not load.')), { once: true });
      document.head.append(script);
    });

    return googleWindow.__ifitallendsGoogleScript;
  }

  async function readApiError(response: Response, fallback: string): Promise<string> {
    try {
      const payload = await response.json() as { error?: { message?: string } };
      return payload.error?.message || fallback;
    } catch {
      return fallback;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-comments]').forEach((root) => {
    const section = root.dataset.section;
    const slug = root.dataset.slug;
    const lang = root.dataset.lang === 'ko' ? 'ko' : 'en';
    if (!section || !slug) return;

    const copy = lang === 'ko'
      ? {
          loading: '댓글을 불러오는 중…', unavailable: '댓글 기능을 아직 사용할 수 없습니다.',
          loadError: '댓글을 불러오지 못했습니다.', loginError: 'Google 로그인을 완료하지 못했습니다.',
          posting: '등록 중…', postError: '댓글을 등록하지 못했습니다.', posted: '댓글이 등록되었습니다.',
          logoutError: '로그아웃하지 못했습니다.', signedIn: '로그인:', confirmLogout: '로그아웃하시겠습니까?',
        }
      : {
          loading: 'Loading comments…', unavailable: 'Comments are not available yet.',
          loadError: 'Comments could not be loaded.', loginError: 'Google sign-in could not be completed.',
          posting: 'Posting…', postError: 'The comment could not be posted.', posted: 'Your comment was posted.',
          logoutError: 'You could not be signed out.', signedIn: 'Signed in as', confirmLogout: 'Sign out?',
        };

    const status = root.querySelector<HTMLElement>('[data-comments-status]');
    const auth = root.querySelector<HTMLElement>('[data-comments-auth]');
    const login = root.querySelector<HTMLButtonElement>('[data-comments-login]');
    const googleButton = root.querySelector<HTMLElement>('[data-comments-google-button]');
    const account = root.querySelector<HTMLElement>('[data-comments-account]');
    const accountName = root.querySelector<HTMLElement>('[data-comments-account-name]');
    const adminLink = root.querySelector<HTMLElement>('[data-comments-admin]');
    const logout = root.querySelector<HTMLButtonElement>('[data-comments-logout]');
    const form = root.querySelector<HTMLFormElement>('[data-comments-form]');
    const textarea = root.querySelector<HTMLTextAreaElement>('[data-comments-body]');
    const count = root.querySelector<HTMLElement>('[data-comments-count]');
    const submit = root.querySelector<HTMLButtonElement>('[data-comments-submit]');
    const blocked = root.querySelector<HTMLElement>('[data-comments-blocked]');
    const list = root.querySelector<HTMLOListElement>('[data-comments-list]');
    const empty = root.querySelector<HTMLElement>('[data-comments-empty]');
    const more = root.querySelector<HTMLButtonElement>('[data-comments-more]');
    if (!status || !auth || !login || !googleButton || !account || !accountName || !adminLink || !logout || !form || !textarea || !count || !submit || !blocked || !list || !empty || !more) return;

    let clientId = '';
    let session: SessionState = { authenticated: false };
    let nextCursor: number | null = null;

    const setStatus = (message = '', isError = false) => {
      status.textContent = message;
      status.classList.toggle('is-error', isError);
      status.hidden = !message;
    };

    const renderSession = () => {
      auth.hidden = session.authenticated;
      account.hidden = !session.authenticated;
      form.hidden = !session.authenticated || Boolean(session.blocked);
      blocked.hidden = !session.authenticated || !session.blocked;
      adminLink.hidden = !session.admin;
      accountName.textContent = session.user?.name ? `${copy.signedIn} ${session.user.name}` : '';
    };

    const createCommentElement = (comment: CommentItem) => {
      const item = document.createElement('li');
      item.className = 'comment-item';
      const heading = document.createElement('div');
      heading.className = 'comment-meta';
      const author = document.createElement('strong');
      author.textContent = comment.author;
      const time = document.createElement('time');
      const date = new Date(comment.createdAt * 1000);
      time.dateTime = date.toISOString();
      time.textContent = new Intl.DateTimeFormat(lang === 'ko' ? 'ko-KR' : 'en-AU', {
        year: 'numeric', month: 'short', day: 'numeric',
      }).format(date);
      const body = document.createElement('p');
      body.textContent = comment.body;
      heading.append(author, time);
      item.append(heading, body);
      return item;
    };

    const loadComments = async (append = false) => {
      if (!append) setStatus(copy.loading);
      const params = new URLSearchParams({ section, slug, lang });
      if (append && nextCursor) params.set('cursor', String(nextCursor));
      try {
        const response = await fetch(`/api/comments?${params}`, { credentials: 'same-origin' });
        if (!response.ok) throw new Error(await readApiError(response, copy.loadError));
        const payload = await response.json() as { comments: CommentItem[]; nextCursor: number | null };
        if (!append) list.replaceChildren();
        payload.comments.forEach((comment) => list.append(createCommentElement(comment)));
        nextCursor = payload.nextCursor;
        more.hidden = nextCursor === null;
        empty.hidden = list.children.length > 0;
        setStatus();
      } catch (error) {
        setStatus(error instanceof Error ? error.message : copy.loadError, true);
      }
    };

    const loadSession = async () => {
      try {
        const response = await fetch('/api/auth/session', { credentials: 'same-origin' });
        if (!response.ok) throw new Error(copy.unavailable);
        session = await response.json() as SessionState;
        renderSession();
      } catch (error) {
        setStatus(error instanceof Error ? error.message : copy.unavailable, true);
      }
    };

    const finishGoogleLogin = async (credential?: string, loginCsrf?: string) => {
      if (!credential || !loginCsrf) {
        setStatus(copy.loginError, true);
        return;
      }
      const response = await fetch('/api/auth/google', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ credential, loginCsrf }),
      });
      if (!response.ok) {
        setStatus(await readApiError(response, copy.loginError), true);
        return;
      }
      googleButton.hidden = true;
      await loadSession();
      textarea.focus();
      setStatus();
    };

    login.addEventListener('click', async () => {
      login.disabled = true;
      setStatus();
      try {
        const [csrfResponse, google] = await Promise.all([
          fetch('/api/auth/csrf', { credentials: 'same-origin' }),
          loadGoogleIdentity(),
        ]);
        if (!csrfResponse.ok) throw new Error(copy.loginError);
        const { token: loginCsrf } = await csrfResponse.json() as { token: string };
        google.accounts.id.initialize({
          client_id: clientId,
          callback: (response) => void finishGoogleLogin(response.credential, loginCsrf),
        });
        google.accounts.id.prompt((notification) => {
          if (notification.isNotDisplayed() || notification.isSkippedMoment()) {
            login.hidden = true;
            googleButton.hidden = false;
            googleButton.replaceChildren();
            google.accounts.id.renderButton(googleButton, {
              type: 'standard', theme: 'filled_black', size: 'large', shape: 'pill',
              text: 'continue_with', locale: lang === 'ko' ? 'ko' : 'en',
            });
          }
        });
      } catch (error) {
        login.hidden = false;
        setStatus(error instanceof Error ? error.message : copy.loginError, true);
      } finally {
        login.disabled = false;
      }
    });

    logout.addEventListener('click', async () => {
      if (!window.confirm(copy.confirmLogout)) return;
      const response = await fetch('/api/auth/session', {
        method: 'DELETE', credentials: 'same-origin',
        headers: { 'X-CSRF-Token': session.csrfToken || '' },
      });
      if (!response.ok) {
        setStatus(await readApiError(response, copy.logoutError), true);
        return;
      }
      googleWindow.google?.accounts.id.disableAutoSelect();
      session = { authenticated: false };
      renderSession();
    });

    textarea.addEventListener('input', () => {
      count.textContent = `${textarea.value.length} / 2000`;
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const originalBody = textarea.value;
      if (!originalBody.trim()) return;
      submit.disabled = true;
      setStatus(copy.posting);
      try {
        const response = await fetch('/api/comments', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': session.csrfToken || '' },
          body: JSON.stringify({ section, slug, lang, body: originalBody }),
        });
        if (!response.ok) throw new Error(await readApiError(response, copy.postError));
        const payload = await response.json() as { comment: CommentItem };
        list.prepend(createCommentElement(payload.comment));
        empty.hidden = true;
        textarea.value = '';
        count.textContent = '0 / 2000';
        setStatus(copy.posted);
      } catch (error) {
        textarea.value = originalBody;
        setStatus(error instanceof Error ? error.message : copy.postError, true);
      } finally {
        submit.disabled = false;
      }
    });

    more.addEventListener('click', () => void loadComments(true));

    void (async () => {
      try {
        const configResponse = await fetch('/api/comments/config', { credentials: 'same-origin' });
        const config = await configResponse.json() as { enabled?: boolean; googleClientId?: string };
        if (!configResponse.ok || !config.enabled || !config.googleClientId) {
          setStatus(copy.unavailable);
          return;
        }
        clientId = config.googleClientId;
        await Promise.all([loadSession(), loadComments()]);
      } catch {
        setStatus(copy.unavailable, true);
      }
    })();
  });
</script>

<style>
  .comments {
    width: calc(100% - 64px);
    max-width: 1120px;
    margin: 0 auto clamp(80px, 10vw, 132px);
    padding-top: clamp(48px, 7vw, 76px);
    border-top: 1px solid rgba(220, 230, 240, 0.14);
  }

  .comments-heading h2 {
    margin: 0 0 12px;
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--editorial-title-weight);
    line-height: 1.15;
  }

  .comments-heading p,
  .comments-privacy-note,
  .comments-status,
  .comments-empty,
  .comments-blocked {
    color: var(--muted);
    line-height: 1.65;
  }

  .comments-status {
    margin: 24px 0;
  }

  .comments-status.is-error,
  .comments-blocked {
    color: #efc1b8;
  }

  .comments-auth,
  .comments-account,
  .comments-form {
    margin-top: 30px;
  }

  .comments-auth {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
  }

  .comments-privacy-note {
    flex-basis: 100%;
    max-width: 68ch;
    margin: 0;
    font-size: 0.86rem;
  }

  .comments-account {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .comments-account p {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 0;
  }

  .comments-account a,
  .comments-text-button {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .comments-text-button {
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .comments-form label {
    display: block;
    margin-bottom: 10px;
    color: var(--text);
    font-weight: 700;
  }

  .comments-form textarea {
    display: block;
    width: 100%;
    min-height: 126px;
    resize: vertical;
    padding: 15px 16px;
    border: 1px solid rgba(220, 230, 240, 0.2);
    border-radius: 4px;
    color: var(--text);
    background: rgba(1, 8, 15, 0.55);
    font: inherit;
    line-height: 1.6;
  }

  .comments-form textarea:focus-visible,
  .comments-button:focus-visible,
  .comments-text-button:focus-visible,
  .comments-account a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .comments-form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 12px;
  }

  .comments-form-footer span {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .comments-button {
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid rgba(220, 230, 240, 0.3);
    border-radius: 999px;
    color: var(--text);
    background: transparent;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .comments-button--primary {
    background: rgba(246, 244, 239, 0.1);
  }

  .comments-button:hover {
    background: rgba(246, 244, 239, 0.16);
  }

  .comments-button:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .comments-list {
    margin: clamp(42px, 6vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }

  :global(.comment-item) {
    padding: 28px 0;
    border-top: 1px solid rgba(220, 230, 240, 0.1);
  }

  :global(.comment-meta) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 12px;
  }

  :global(.comment-meta time) {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.8rem;
  }

  :global(.comment-item > p) {
    margin: 0;
    color: var(--body-text);
    line-height: 1.75;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .comments-empty {
    margin: 38px 0 0;
  }

  .comments-more {
    margin-top: 26px;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 760px) {
    .comments {
      width: calc(100% - 36px);
      margin-bottom: 76px;
      padding-top: 42px;
    }

    .comments-account,
    .comment-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .comments-button--primary,
    .comments-google-button {
      max-width: 100%;
    }
  }
</style>
