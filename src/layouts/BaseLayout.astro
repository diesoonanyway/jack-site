---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import StorySearch from '../components/StorySearch.astro';
import { serializeJsonLd, SITE_NAME } from '../lib/seo';

const {
  title = SITE_NAME,
  description = 'What I Feel, What I Learn, and useful things.',
  image = '/images/moon-ocean.png',
  type = 'website',
  noindex = false,
  lang = 'en',
  alternatePath,
  publishedTime,
  structuredData,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;

const hasAlternate =
  typeof alternatePath === 'string' && alternatePath.length > 0;

const enPath = lang === 'en'
  ? Astro.url.pathname
  : alternatePath;

const koPath = lang === 'ko'
  ? Astro.url.pathname
  : alternatePath;

const enAlternateURL = hasAlternate && Astro.site
  ? new URL(enPath, Astro.site)
  : undefined;

const koAlternateURL = hasAlternate && Astro.site
  ? new URL(koPath, Astro.site)
  : undefined;

const pathPrefix = lang === 'ko' ? '/ko' : '';
const homePath = lang === 'ko' ? '/ko/' : '/';

const navigation = lang === 'ko'
  ? {
      whatIFeel: 'What I Feel',
      whatILearn: 'What I Learn',
      about: '소개',
      newsletter: '뉴스레터',
      privacy: '개인정보 처리방침',
      contact: '연락처',
    }
  : {
      whatIFeel: 'What I Feel',
      whatILearn: 'What I Learn',
      about: 'About',
      newsletter: 'Newsletter',
      privacy: 'Privacy',
      contact: 'Contact',
    };

const socialImageURL = Astro.site
  ? new URL(image, Astro.site)
  : image;

const serializedStructuredData = structuredData
  ? serializeJsonLd(structuredData)
  : undefined;

const isProduction = import.meta.env.PROD;

const measurementId = 'G-Z9K72KWHGP';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    {isProduction && (
      <>
        <!-- Google Consent Mode: privacy-first defaults -->
        <script is:inline>
          window.dataLayer = window.dataLayer || [];

          window.gtag = window.gtag || function () {
            window.dataLayer.push(arguments);
          };

          window.gtag('consent', 'default', {
            ad_storage: 'denied',
            analytics_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            wait_for_update: 1000
          });
        </script>

        <!-- InMobi Choice. Consent Manager Tag v3.0 (for TCF 2.3) -->
        <script is:inline type="text/javascript">
          (function() {
            var host = window.location.hostname;
            var element = document.createElement('script');
            var firstScript = document.getElementsByTagName('script')[0];

            var url = 'https://cmp.inmobi.com'
              .concat(
                '/choice/',
                'uhzk8BkQJZZzn',
                '/',
                host,
                '/choice.js?tag_version=V3'
              );

            var uspTries = 0;
            var uspTriesLimit = 3;

            element.async = true;
            element.type = 'text/javascript';
            element.src = url;

            firstScript.parentNode.insertBefore(
              element,
              firstScript
            );

            function makeStub() {
              var TCF_LOCATOR_NAME = '__tcfapiLocator';
              var queue = [];
              var win = window;
              var cmpFrame;

              function addFrame() {
                var doc = win.document;
                var otherCMP = !!(
                  win.frames[TCF_LOCATOR_NAME]
                );

                if (!otherCMP) {
                  if (doc.body) {
                    var iframe =
                      doc.createElement('iframe');

                    iframe.style.cssText =
                      'display:none';

                    iframe.name =
                      TCF_LOCATOR_NAME;

                    doc.body.appendChild(iframe);
                  } else {
                    setTimeout(addFrame, 5);
                  }
                }

                return !otherCMP;
              }

              function tcfAPIHandler() {
                var gdprApplies;
                var args = arguments;

                if (!args.length) {
                  return queue;
                } else if (
                  args[0] === 'setGdprApplies'
                ) {
                  if (
                    args.length > 3 &&
                    args[2] === 2 &&
                    typeof args[3] === 'boolean'
                  ) {
                    gdprApplies = args[3];

                    if (
                      typeof args[2] ===
                      'function'
                    ) {
                      args[2]('set', true);
                    }
                  }
                } else if (
                  args[0] === 'ping'
                ) {
                  var retr = {
                    gdprApplies: gdprApplies,
                    cmpLoaded: false,
                    cmpStatus: 'stub'
                  };

                  if (
                    typeof args[2] ===
                    'function'
                  ) {
                    args[2](retr);
                  }
                } else {
                  if (
                    args[0] === 'init' &&
                    typeof args[3] === 'object'
                  ) {
                    args[3] = Object.assign(
                      args[3],
                      {
                        tag_version: 'V3'
                      }
                    );
                  }

                  queue.push(args);
                }
              }

              function postMessageEventHandler(
                event
              ) {
                var msgIsString =
                  typeof event.data === 'string';

                var json = {};

                try {
                  if (msgIsString) {
                    json = JSON.parse(
                      event.data
                    );
                  } else {
                    json = event.data;
                  }
                } catch (ignore) {}

                var payload =
                  json.__tcfapiCall;

                if (payload) {
                  window.__tcfapi(
                    payload.command,
                    payload.version,
                    function(
                      retValue,
                      success
                    ) {
                      var returnMsg = {
                        __tcfapiReturn: {
                          returnValue:
                            retValue,
                          success:
                            success,
                          callId:
                            payload.callId
                        }
                      };

                      if (msgIsString) {
                        returnMsg =
                          JSON.stringify(
                            returnMsg
                          );
                      }

                      if (
                        event &&
                        event.source &&
                        event.source
                          .postMessage
                      ) {
                        event.source
                          .postMessage(
                            returnMsg,
                            '*'
                          );
                      }
                    },
                    payload.parameter
                  );
                }
              }

              while (win) {
                try {
                  if (
                    win.frames[
                      TCF_LOCATOR_NAME
                    ]
                  ) {
                    cmpFrame = win;
                    break;
                  }
                } catch (ignore) {}

                if (
                  win === window.top
                ) {
                  break;
                }

                win = win.parent;
              }

              if (!cmpFrame) {
                addFrame();

                win.__tcfapi =
                  tcfAPIHandler;

                win.addEventListener(
                  'message',
                  postMessageEventHandler,
                  false
                );
              }
            }

            makeStub();

            function makeGppStub() {
              const CMP_ID = 10;

              const SUPPORTED_APIS = [
                '2:tcfeuv2',
                '6:uspv1',
                '7:usnatv1',
                '8:usca',
                '9:usvav1',
                '10:uscov1',
                '11:usutv1',
                '12:usctv1'
              ];

              window.__gpp_addFrame =
                function(n) {
                  if (!window.frames[n]) {
                    if (document.body) {
                      var i =
                        document.createElement(
                          'iframe'
                        );

                      i.style.cssText =
                        'display:none';

                      i.name = n;

                      document.body
                        .appendChild(i);
                    } else {
                      window.setTimeout(
                        window.__gpp_addFrame,
                        10,
                        n
                      );
                    }
                  }
                };

              window.__gpp_stub =
                function() {
                  var b = arguments;

                  __gpp.queue =
                    __gpp.queue || [];

                  __gpp.events =
                    __gpp.events || [];

                  if (
                    !b.length ||
                    (
                      b.length === 1 &&
                      b[0] === 'queue'
                    )
                  ) {
                    return __gpp.queue;
                  }

                  if (
                    b.length === 1 &&
                    b[0] === 'events'
                  ) {
                    return __gpp.events;
                  }

                  var cmd = b[0];

                  var clb =
                    b.length > 1
                      ? b[1]
                      : null;

                  var par =
                    b.length > 2
                      ? b[2]
                      : null;

                  if (cmd === 'ping') {
                    clb(
                      {
                        gppVersion: '1.1',
                        cmpStatus: 'stub',
                        cmpDisplayStatus:
                          'hidden',
                        signalStatus:
                          'not ready',
                        supportedAPIs:
                          SUPPORTED_APIS,
                        cmpId: CMP_ID,
                        sectionList: [],
                        applicableSections:
                          [-1],
                        gppString: '',
                        parsedSections: {}
                      },
                      true
                    );
                  } else if (
                    cmd ===
                    'addEventListener'
                  ) {
                    if (
                      !('lastId' in __gpp)
                    ) {
                      __gpp.lastId = 0;
                    }

                    __gpp.lastId++;

                    var lnr =
                      __gpp.lastId;

                    __gpp.events.push({
                      id: lnr,
                      callback: clb,
                      parameter: par
                    });

                    clb(
                      {
                        eventName:
                          'listenerRegistered',
                        listenerId: lnr,
                        data: true,
                        pingData: {
                          gppVersion:
                            '1.1',
                          cmpStatus:
                            'stub',
                          cmpDisplayStatus:
                            'hidden',
                          signalStatus:
                            'not ready',
                          supportedAPIs:
                            SUPPORTED_APIS,
                          cmpId: CMP_ID,
                          sectionList: [],
                          applicableSections:
                            [-1],
                          gppString: '',
                          parsedSections: {}
                        }
                      },
                      true
                    );
                  } else if (
                    cmd ===
                    'removeEventListener'
                  ) {
                    var success = false;

                    for (
                      var i = 0;
                      i <
                      __gpp.events.length;
                      i++
                    ) {
                      if (
                        __gpp.events[i]
                          .id === par
                      ) {
                        __gpp.events
                          .splice(i, 1);

                        success = true;
                        break;
                      }
                    }

                    clb(
                      {
                        eventName:
                          'listenerRemoved',
                        listenerId: par,
                        data: success,
                        pingData: {
                          gppVersion:
                            '1.1',
                          cmpStatus:
                            'stub',
                          cmpDisplayStatus:
                            'hidden',
                          signalStatus:
                            'not ready',
                          supportedAPIs:
                            SUPPORTED_APIS,
                          cmpId: CMP_ID,
                          sectionList: [],
                          applicableSections:
                            [-1],
                          gppString: '',
                          parsedSections: {}
                        }
                      },
                      true
                    );
                  } else if (
                    cmd === 'hasSection'
                  ) {
                    clb(false, true);
                  } else if (
                    cmd ===
                      'getSection' ||
                    cmd === 'getField'
                  ) {
                    clb(null, true);
                  } else {
                    __gpp.queue.push(
                      [].slice.apply(b)
                    );
                  }
                };

              window.__gpp_msghandler =
                function(event) {
                  var msgIsString =
                    typeof event.data ===
                    'string';

                  try {
                    var json =
                      msgIsString
                        ? JSON.parse(
                            event.data
                          )
                        : event.data;
                  } catch (e) {
                    var json = null;
                  }

                  if (
                    typeof json ===
                      'object' &&
                    json !== null &&
                    '__gppCall' in json
                  ) {
                    var i =
                      json.__gppCall;

                    window.__gpp(
                      i.command,
                      function(
                        retValue,
                        success
                      ) {
                        var returnMsg = {
                          __gppReturn: {
                            returnValue:
                              retValue,
                            success:
                              success,
                            callId:
                              i.callId
                          }
                        };

                        event.source
                          .postMessage(
                            msgIsString
                              ? JSON.stringify(
                                  returnMsg
                                )
                              : returnMsg,
                            '*'
                          );
                      },
                      'parameter' in i
                        ? i.parameter
                        : null,
                      'version' in i
                        ? i.version
                        : '1.1'
                    );
                  }
                };

              if (
                !('__gpp' in window) ||
                typeof window.__gpp !==
                  'function'
              ) {
                window.__gpp =
                  window.__gpp_stub;

                window.addEventListener(
                  'message',
                  window.__gpp_msghandler,
                  false
                );

                window.__gpp_addFrame(
                  '__gppLocator'
                );
              }
            }

            makeGppStub();

            var uspStubFunction =
              function() {
                var arg = arguments;

                if (
                  typeof window.__uspapi !==
                  uspStubFunction
                ) {
                  setTimeout(
                    function() {
                      if (
                        typeof window
                          .__uspapi !==
                        'undefined'
                      ) {
                        window.__uspapi
                          .apply(
                            window.__uspapi,
                            arg
                          );
                      }
                    },
                    500
                  );
                }
              };

            var checkIfUspIsReady =
              function() {
                uspTries++;

                if (
                  window.__uspapi ===
                    uspStubFunction &&
                  uspTries <
                    uspTriesLimit
                ) {
                  console.warn(
                    'USP is not accessible'
                  );
                } else {
                  clearInterval(
                    uspInterval
                  );
                }
              };

            if (
              typeof window.__uspapi ===
              'undefined'
            ) {
              window.__uspapi =
                uspStubFunction;

              var uspInterval =
                setInterval(
                  checkIfUspIsReady,
                  6000
                );
            }
          })();
        </script>
        <!-- End InMobi Choice. Consent Manager Tag v3.0 (for TCF 2.3) -->

        <!-- Google Analytics 4 -->
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
        ></script>

        <script
          is:inline
          define:vars={{ measurementId }}
        >
          window.gtag(
            'js',
            new Date()
          );

          window.gtag(
            'config',
            measurementId
          );
        </script>
      </>
    )}

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="google-adsense-account"
      content="ca-pub-7011660665339454"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow'}
    />

    {canonicalURL && (
      <link
        rel="canonical"
        href={canonicalURL.toString()}
      />
    )}

    {enAlternateURL && koAlternateURL && (
      <>
        <link
          rel="alternate"
          hreflang="en"
          href={enAlternateURL.toString()}
        />

        <link
          rel="alternate"
          hreflang="ko"
          href={koAlternateURL.toString()}
        />
      </>
    )}

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:type"
      content={type}
    />

    {canonicalURL && (
      <meta
        property="og:url"
        content={canonicalURL.toString()}
      />
    )}

    <meta
      property="og:image"
      content={socialImageURL.toString()}
    />

    <meta
      property="og:site_name"
      content={SITE_NAME}
    />

    {type === 'article' && publishedTime && (
      <meta
        property="article:published_time"
        content={publishedTime}
      />
    )}

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={socialImageURL.toString()}
    />

    {serializedStructuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={serializedStructuredData}
      ></script>
    )}

    <style is:global>
      :root {
        --bg: #01060b;
        --text: #f6f4ef;
        --body-text: #dce3ea;
        --muted: #adb9c5;
        --line: rgba(255, 255, 255, 0.12);
        --accent: #dbeaff;
        --accent-strong: #ffffff;
        --max: 1480px;
        --reading: 780px;
        --font-english:
          Georgia,
          'Times New Roman',
          Times,
          serif;
        --font-korean:
          Batang,
          '바탕',
          'Noto Serif KR',
          'Noto Serif CJK KR',
          AppleMyungjo,
          serif;
        --font-site: var(--font-english);
        --font-editorial: var(--font-site);
        --editorial-title-weight: 500;
        --editorial-title-leading: 1.14;
        --editorial-title-tracking: -0.015em;
        --shadow:
          0 24px 80px
          rgba(0, 0, 0, 0.22);
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
        scroll-behavior: smooth;
        background: var(--bg);
      }

      html:lang(ko) {
        --font-site: var(--font-korean);
      }

      body {
        position: relative;

        margin: 0;
        min-height: 100vh;

        overflow-x: hidden;

        color: var(--text);

        font-family: var(--font-site);
        line-height: 1.6;

        background-color: var(--bg);

        background-image:
          linear-gradient(
            rgba(1, 6, 12, 0.08),
            rgba(1, 6, 12, 0.12)
          ),
          url('/images/moon-ocean.png');

        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        background-attachment: fixed;
      }

      .page-depth {
        position: absolute;
        inset: 0;

        z-index: 0;
        pointer-events: none;

        background:
          linear-gradient(
            to bottom,
            rgba(1, 7, 13, 0.03) 0%,
            rgba(2, 12, 22, 0.08) 8%,
            rgba(2, 15, 29, 0.16) 18%,
            rgba(2, 17, 33, 0.26) 30%,
            rgba(1, 14, 29, 0.38) 43%,
            rgba(1, 11, 24, 0.52) 56%,
            rgba(1, 9, 20, 0.66) 69%,
            rgba(0, 7, 16, 0.78) 82%,
            rgba(0, 4, 10, 0.91) 100%
          );
      }

      .mobile-site-background,
      .mobile-scroll-darkener {
        display: none;
      }

      .site-shell {
        position: relative;
        z-index: 1;

        width: min(
          calc(100% - 32px),
          var(--max)
        );

        margin: 0 auto;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      a:hover {
        color: var(--accent);
      }

      .site-header {
        position: sticky;

        top: 14px;
        z-index: 50;

        display: flex;

        justify-content: space-between;
        align-items: center;
        gap: 32px;

        width: 100%;

        padding: 22px 30px;

        margin-top: 14px;

        border: 1px solid var(--line);
        border-radius: 18px;

        background:
          rgba(1, 7, 14, 0.7);

        backdrop-filter: blur(16px);
        -webkit-backdrop-filter:
          blur(16px);

        box-shadow: var(--shadow);
      }

      .brand {
        flex: 0 0 auto;

        font-family:
          var(--font-editorial);

        font-size: 1.75rem;
        font-weight:
          var(--editorial-title-weight);

        line-height: 1.1;
        letter-spacing: -0.01em;

        white-space: nowrap;
      }

      .nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;

        gap: 26px;

        font-size: 0.98rem;
      }

      .nav-primary {
        display: flex;
        align-items: center;

        gap: 26px;
      }

      .nav a {
        color: var(--text);
      }

      .nav .subscribe-link {
        padding: 8px 16px;

        border:
          1px solid
          rgba(255, 255, 255, 0.28);

        border-radius: 999px;

        background:
          rgba(255, 255, 255, 0.06);
      }

      .nav .subscribe-link:hover {
        color: #ffffff;

        background:
          rgba(255, 255, 255, 0.14);
      }

      main {
        width: 100%;

        padding:
          30px 0 100px;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        font-size:
          clamp(
            4.5rem,
            8vw,
            8.6rem
          );

        line-height: 0.9;

        letter-spacing: -0.06em;
      }

      h2 {
        font-size:
          clamp(
            2.7rem,
            5vw,
            5rem
          );

        line-height: 0.98;

        letter-spacing: -0.05em;
      }

      h3 {
        font-size:
          clamp(
            1.7rem,
            3vw,
            2.5rem
          );

        line-height: 1.08;

        letter-spacing: -0.03em;
      }

      h1,
      h2,
      h3 {
        text-shadow:
          0 5px 36px
          rgba(0, 0, 0, 0.58);
      }

      .editorial-title {
        font-family:
          var(--font-editorial);

        font-weight:
          var(--editorial-title-weight);

        line-height:
          var(--editorial-title-leading);

        letter-spacing:
          var(--editorial-title-tracking);
      }

      .muted {
        color: var(--muted);
      }

      .reading-width {
        max-width:
          var(--reading);
      }

      .article-body {
        max-width:
          var(--reading);

        color:
          var(--body-text);

        font-size: 1.12rem;
      }

      .article-body p {
        margin-bottom: 1.5em;
      }

      .eyebrow {
        color: var(--muted);

        font-size: 0.82rem;
        font-weight: 700;

        letter-spacing: 0.14em;

        text-transform: uppercase;
      }

      .text-link {
        display: inline-block;

        margin-top: 16px;

        font-weight: 700;
      }

      .text-link::after {
        content: " →";
      }

      .site-footer {
        display: flex;

        justify-content: space-between;
        align-items: center;

        gap: 24px;

        width: 100%;

        padding: 24px 30px;

        margin-bottom: 18px;

        border: 1px solid var(--line);
        border-radius: 18px;

        background:
          rgba(0, 4, 10, 0.8);

        backdrop-filter: blur(12px);
        -webkit-backdrop-filter:
          blur(12px);

        color: var(--muted);
        font-size: 0.88rem;

        box-shadow: var(--shadow);
      }

      .footer-right {
        display: flex;

        align-items: center;

        gap: 14px;
      }

      .footer-link {
        color: var(--muted);

        white-space: nowrap;
      }

      .footer-link:hover {
        color: var(--accent);
      }

      .footer-divider {
        color:
          rgba(
            255,
            255,
            255,
            0.28
          );
      }

      @media (max-width: 760px) {
        body {
          background-image: none;
          background-attachment: scroll;
        }

        .mobile-site-background,
        .mobile-scroll-darkener {
          position: fixed;
          top: 0;
          left: 0;
          display: block;
          width: 100vw;
          height: 100vh;
          height: 100dvh;
          pointer-events: none;
        }

        .mobile-site-background {
          z-index: 0;
          background-color: var(--bg);
          background-image:
            linear-gradient(
              rgba(1, 6, 12, 0.08),
              rgba(1, 6, 12, 0.12)
            ),
            url('/images/moon-ocean.png');
          background-size: cover;
          background-position: 50% 50%;
          background-repeat: no-repeat;
        }

        .mobile-scroll-darkener {
          z-index: 1;
          background: #000;
          opacity: var(--mobile-scroll-darkness, 0);
          will-change: opacity;
        }

        .page-depth {
          display: none;
        }

        .site-shell {
          z-index: 2;
          width:
            calc(100% - 20px);
        }

        .site-header {
          top: 8px;

          display: grid;

          grid-template-columns:
            minmax(0, 1fr)
            auto;

          align-items: center;

          gap: 12px;

          padding: 14px;
        }

        .brand {
          grid-column: 1;
          grid-row: 1;

          min-width: 0;

          font-size: 1.375rem;
        }

        .nav {
          display: contents;
        }

        .nav-primary {
          grid-column: 1 / -1;
          grid-row: 2;

          display: flex;

          align-items: center;

          gap:
            clamp(
              12px,
              4vw,
              18px
            );

          min-width: 0;
          max-width: 100%;

          padding-bottom: 2px;

          overflow-x: auto;

          overscroll-behavior-inline:
            contain;

          scrollbar-width: none;

          font-size:
            clamp(
              0.78rem,
              3.6vw,
              0.9rem
            );

          white-space: nowrap;
        }

        .nav-primary::-webkit-scrollbar {
          display: none;
        }

        .nav-primary > a,
        .nav-primary > .story-search {
          flex: 0 0 auto;
        }

        .nav .language-switcher {
          grid-column: 2;
          grid-row: 1;

          justify-self: end;
        }

        .nav .language-hint {
          right: 0;
          left: auto;
        }

        .nav .language-hint::before {
          right: 20px;
          left: auto;
        }

        .nav .subscribe-link {
          padding: 6px 10px;
        }

        h1 {
          font-size:
            clamp(
              3.4rem,
              17vw,
              5.4rem
            );
        }

        h2 {
          font-size:
            clamp(
              2.3rem,
              12vw,
              4rem
            );
        }

        .site-footer {
          align-items: flex-start;

          flex-direction: column;

          padding: 20px 18px;
        }

        .footer-right {
          align-items: flex-start;

          flex-wrap: wrap;

          gap: 8px 12px;
        }
      }
    </style>
  </head>

  <body>
    <div
      class="mobile-site-background"
      aria-hidden="true"
    ></div>

    <div
      class="mobile-scroll-darkener"
      aria-hidden="true"
    ></div>

    <div
      class="page-depth"
      aria-hidden="true"
    ></div>

    <div class="site-shell">
      <header class="site-header">
        <a
          href={homePath}
          class="brand"
        >
          If It All Ends
        </a>

        <nav class="nav">
          <div class="nav-primary">
            <a
              href={`${pathPrefix}/what-i-feel/`}
            >
              {navigation.whatIFeel}
            </a>

            <a
              href={`${pathPrefix}/what-i-learn/`}
            >
              {navigation.whatILearn}
            </a>

            <a
              href={`${pathPrefix}/about/`}
            >
              {navigation.about}
            </a>

            <a
              href={`${homePath}#subscribe`}
              class="subscribe-link"
            >
              {navigation.newsletter}
            </a>

            <StorySearch {lang} />
          </div>

          <LanguageSwitcher
            {lang}
            {enPath}
            {koPath}
          />
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>
          © {new Date().getFullYear()} If It All Ends
        </span>

        <div class="footer-right">
          <a
            href={`${pathPrefix}/privacy/`}
            class="footer-link"
          >
            {navigation.privacy}
          </a>

          <span
            class="footer-divider"
            aria-hidden="true"
          >
            ·
          </span>

          <a
            href={`${pathPrefix}/contact/`}
            class="footer-link"
          >
            {navigation.contact}
          </a>
        </div>
      </footer>
    </div>

    <script>
      const mobileBackgroundQuery = window.matchMedia('(max-width: 760px)');
      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      const rootElement = document.documentElement;
      let mobileDarkeningFrame = 0;

      const updateMobileScrollDarkness = () => {
        mobileDarkeningFrame = 0;

        if (!mobileBackgroundQuery.matches) {
          rootElement.style.removeProperty('--mobile-scroll-darkness');
          return;
        }

        const scrollRange = Math.max(rootElement.scrollHeight - window.innerHeight, 1);
        const progress = Math.min(Math.max(window.scrollY / scrollRange, 0), 1);
        const easedProgress = reducedMotionQuery.matches
          ? progress
          : progress * progress * (3 - 2 * progress);

        rootElement.style.setProperty(
          '--mobile-scroll-darkness',
          (easedProgress * 0.74).toFixed(3),
        );
      };

      const queueMobileScrollDarknessUpdate = () => {
        if (mobileDarkeningFrame) return;
        mobileDarkeningFrame = window.requestAnimationFrame(updateMobileScrollDarkness);
      };

      updateMobileScrollDarkness();
      window.addEventListener('scroll', queueMobileScrollDarknessUpdate, { passive: true });
      window.addEventListener('resize', queueMobileScrollDarknessUpdate);
      window.visualViewport?.addEventListener('resize', queueMobileScrollDarknessUpdate);
      mobileBackgroundQuery.addEventListener('change', queueMobileScrollDarknessUpdate);
      reducedMotionQuery.addEventListener('change', queueMobileScrollDarknessUpdate);
    </script>
  </body>
</html>
