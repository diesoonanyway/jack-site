---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/editorial.css';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';

const posts = (await getCollection('apps'))
  .filter((post) => !post.data.draft && post.data.lang === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={isKorean ? '앱 — Jack' : 'Apps — Jack'}
  description={
    isKorean
      ? '아이디어를 실제로 사용할 수 있는 것으로 만듭니다.'
      : 'Ideas turned into things people can actually use.'
  }
  {lang}
  alternatePath={isKorean ? '/apps/' : '/ko/apps/'}
>
  <section class="editorial-intro">
    <p class="eyebrow">{isKorean ? '제품' : 'Products'}</p>

    <h1>{isKorean ? '앱' : 'Apps'}</h1>

    <p class="muted">
      {isKorean
        ? '생각이 실제로 사용할 수 있는 무언가가 되는 곳입니다.'
        : 'Where ideas become something useful in the real world.'}
    </p>
  </section>

  <section class="editorial-list-section">
    {posts.length > 0 ? (
      <div class="editorial-list">
        {posts.map((post) => (
          <article class="editorial-entry">
            <p class="eyebrow">
              {post.data.date.toLocaleDateString(dateLocale, {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>

            <h2>
              <a href={`${pathPrefix}/apps/${post.id}/`}>
                {post.data.title}
              </a>
            </h2>

            {post.data.description && (
              <p class="muted entry-description">
                {post.data.description}
              </p>
            )}

            <a
              class="text-link"
              href={`${pathPrefix}/apps/${post.id}/`}
            >
              {isKorean ? '자세히 보기' : 'Explore'} →
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">
        {isKorean
          ? '아직 공개된 앱이 없습니다.'
          : 'No published apps yet.'}
      </p>
    )}
  </section>
</BaseLayout>
