---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicSlug } from '../../lib/content-slug';

export async function getStaticPaths() {
  const posts = await getCollection('writing');

  return posts
    .filter((post) => !post.data.draft && post.data.lang === 'en')
    .map((post) => ({
      params: { id: getPublicSlug(post.id, post.data.lang) },
      props: { post },
    }));
}

const { post, lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — Jack`}
  description={post.data.description || post.data.title}
  {lang}
  alternatePath={post.data.translation}
>
  <article class="writing-detail">
    <p class="eyebrow">
      <a href={`${pathPrefix}/writing/`}>{isKorean ? '글' : 'Writing'}</a>
    </p>

    <h1>{post.data.title}</h1>

    <p class="muted article-date">
      {post.data.date.toLocaleDateString(isKorean ? 'ko-KR' : 'en-AU', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </p>

    {post.data.description && (
      <p>{post.data.description}</p>
    )}

    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .writing-detail {
    width: 100%;
    max-width: 1100px;
    padding-inline: 24px;
    margin-inline: auto;
  }

  .writing-detail h1 {
    font-size: clamp(3.4rem, 6vw, 6.2rem);
  }

  .writing-detail .article-date {
    margin-bottom: 0;
    padding-bottom: 4rem;
  }

  .writing-detail .article-body {
    max-width: none;
  }

  @media (max-width: 760px) {
    .writing-detail {
      padding-inline: 18px;
    }

    .writing-detail .article-date {
      padding-bottom: 2.5rem;
    }
  }
</style>