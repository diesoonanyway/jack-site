---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('writing'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Writing — Jack"
  description="Essays, ideas and useful writing."
>
  <section class="reading-width">
    <p class="eyebrow">Writing</p>
    <h1>Writing</h1>

    <p class="muted">
      Essays, observations and ideas worth developing.
    </p>
  </section>

  <section class="section">
    {posts.length > 0 ? (
      <div>
        {posts.map((post) => (
          <article style="margin-bottom: 56px;">
            <p class="eyebrow">
              {post.data.date.toLocaleDateString('en-AU', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>

            <h2>
              <a href={`/writing/${post.id}/`}>
                {post.data.title}
              </a>
            </h2>

            {post.data.description && (
              <p class="muted reading-width">
                {post.data.description}
              </p>
            )}

            <a class="text-link" href={`/writing/${post.id}/`}>
              Read
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p>No published writing yet.</p>
    )}
  </section>
</BaseLayout>