---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicSlug } from '../../lib/content-slug';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';

const posts = (await getCollection('writing'))
  .filter((post) => !post.data.draft && post.data.lang === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={isKorean ? '글 — Jack' : 'Writing — Jack'}
  description={isKorean ? '에세이, 아이디어 그리고 유용한 글.' : 'Essays, ideas and useful writing.'}
  {lang}
  alternatePath={isKorean ? '/writing/' : '/ko/writing/'}
>
  <section class="reading-width">
    <p class="eyebrow">{isKorean ? '글' : 'Writing'}</p>
    <h1>{isKorean ? '글' : 'Writing'}</h1>

    <p class="muted">
      {isKorean
        ? '발전시킬 가치가 있는 에세이, 관찰 그리고 아이디어입니다.'
        : 'Essays, observations and ideas worth developing.'}
    </p>
  </section>

  <section class="section">
    {posts.length > 0 ? (
      <div>
        {posts.map((post) => (
          <article style="margin-bottom: 56px;">
            <p class="eyebrow">
              {post.data.date.toLocaleDateString(dateLocale, {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>

            <h2>
              <a href={`${pathPrefix}/writing/${getPublicSlug(post.id, post.data.lang)}/`}>
                {post.data.title}
              </a>
            </h2>

            {post.data.description && (
              <p class="muted reading-width">
                {post.data.description}
              </p>
            )}

            <a
              class="text-link"
              href={`${pathPrefix}/writing/${getPublicSlug(post.id, post.data.lang)}/`}
            >
              {isKorean ? '읽기' : 'Read'}
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p>{isKorean ? '아직 발행된 글이 없습니다.' : 'No published writing yet.'}</p>
    )}
  </section>
</BaseLayout>
