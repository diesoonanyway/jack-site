---
import BaseLayout from '../layouts/BaseLayout.astro';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
---

<BaseLayout
  title={isKorean ? '연락처 — If It All Ends' : 'Contact — If It All Ends'}
  description={isKorean
    ? 'If It All Ends에 연락하는 방법입니다.'
    : 'Get in touch with If It All Ends.'}
  {lang}
  alternatePath={isKorean ? '/contact/' : '/ko/contact/'}
>
  <section class="contact-page">
    <div class="contact-header">
      <p class="eyebrow">
        {isKorean ? '연락처' : 'Contact'}
      </p>

      <h1>
        {isKorean ? '연락하세요.' : 'Get in touch.'}
      </h1>

      <p class="intro">
        {isKorean
          ? '피드백, 질문, 협업 또는 사이트와 관련된 문의는 이메일로 보내 주세요.'
          : 'For feedback, questions, collaborations, or anything related to the site, you can reach me by email.'}
      </p>
    </div>

    <div class="contact-content">
      <div class="contact-block">
        <p class="label">
          {isKorean ? '이메일' : 'Email'}
        </p>

        <a
          href="mailto:hello@ifitallends.com"
          class="email-link"
        >
          hello@ifitallends.com
        </a>
      </div>

      <div class="contact-note">
        <p>
          {isKorean ? '보내 주신 모든 메시지를 읽습니다.' : 'I read every message.'}
        </p>

        <p>
          {isKorean
            ? '특정 글, 팟캐스트, 영상 또는 앱에 관한 내용이라면 무엇을 말씀하시는지 알 수 있도록 제목이나 링크를 함께 보내 주세요.'
            : "If you're writing about a specific article, podcast, video, or app, include the title or link so I know what you're referring to."}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .contact-page {
    margin-top: 24px;
  }

  .contact-header {
    padding: 80px 64px;

    border:
      1px solid var(--line);

    background:
      rgba(1, 8, 15, 0.74);
  }

  .contact-header h1 {
    max-width: 1000px;

    margin:
      24px 0 32px;
  }

  .contact-header .intro {
    max-width: 680px;

    margin-bottom: 0;

    color: var(--body-text);

    font-size: 1.12rem;

    line-height: 1.8;
  }

  .contact-content {
    display: grid;

    grid-template-columns:
      1.1fr 0.9fr;

    gap: 80px;

    padding: 72px 64px;

    margin-top: 24px;

    border:
      1px solid var(--line);

    background:
      rgba(0, 6, 14, 0.82);
  }

  .contact-block {
    min-width: 0;
  }

  .label {
    margin-bottom: 18px;

    color: var(--muted);

    font-size: 0.82rem;

    font-weight: 700;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }

  .email-link {
    display: inline-block;

    max-width: 100%;

    overflow-wrap: anywhere;

    color: var(--accent);

    font-size:
      clamp(
        2rem,
        4vw,
        4rem
      );

    font-weight: 700;

    line-height: 1.05;

    letter-spacing: -0.04em;
  }

  .email-link:hover {
    color: var(--accent-strong);
  }

  .contact-note {
    max-width: 460px;
  }

  .contact-note p {
    color: var(--body-text);

    font-size: 1.05rem;

    line-height: 1.8;
  }

  .contact-note p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .contact-header,
    .contact-content {
      padding:
        40px 22px;
    }

    .contact-content {
      grid-template-columns:
        1fr;

      gap: 42px;
    }
  }
</style>
