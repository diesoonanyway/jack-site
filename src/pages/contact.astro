---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — If It All Ends"
  description="Get in touch with If It All Ends."
>
  <section class="contact-page">
    <div class="contact-header">
      <p class="eyebrow">
        Contact
      </p>

      <h1>
        Get in touch.
      </h1>

      <p class="intro">
        For feedback, questions, collaborations,
        or anything related to the site,
        you can reach me by email.
      </p>
    </div>

    <div class="contact-content">
      <div class="contact-block">
        <p class="label">
          Email
        </p>

        <a
          href="mailto:hello@ifitallends.com"
          class="email-link"
        >
          hello@ifitallends.com
        </a>
      </div>

      <div class="contact-note">
        <p>
          I read every message.
        </p>

        <p>
          If you're writing about a specific article,
          podcast, video, or app, include the title
          or link so I know what you're referring to.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .contact-page {
    margin-top: 24px;
  }

  .contact-header {
    padding: 80px 64px;

    border:
      1px solid var(--line);

    background:
      rgba(1, 8, 15, 0.74);
  }

  .contact-header h1 {
    max-width: 1000px;

    margin:
      24px 0 32px;
  }

  .contact-header .intro {
    max-width: 680px;

    margin-bottom: 0;

    color: var(--body-text);

    font-size: 1.12rem;

    line-height: 1.8;
  }

  .contact-content {
    display: grid;

    grid-template-columns:
      1.1fr 0.9fr;

    gap: 80px;

    padding: 72px 64px;

    margin-top: 24px;

    border:
      1px solid var(--line);

    background:
      rgba(0, 6, 14, 0.82);
  }

  .contact-block {
    min-width: 0;
  }

  .label {
    margin-bottom: 18px;

    color: var(--muted);

    font-size: 0.82rem;

    font-weight: 700;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }

  .email-link {
    display: inline-block;

    max-width: 100%;

    overflow-wrap: anywhere;

    color: var(--accent);

    font-size:
      clamp(
        2rem,
        4vw,
        4rem
      );

    font-weight: 700;

    line-height: 1.05;

    letter-spacing: -0.04em;
  }

  .email-link:hover {
    color: var(--accent-strong);
  }

  .contact-note {
    max-width: 460px;
  }

  .contact-note p {
    color: var(--body-text);

    font-size: 1.05rem;

    line-height: 1.8;
  }

  .contact-note p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .contact-header,
    .contact-content {
      padding:
        40px 22px;
    }

    .contact-content {
      grid-template-columns:
        1fr;

      gap: 42px;
    }
  }
</style>