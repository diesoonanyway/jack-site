---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicSlug } from '../lib/content-slug';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const localizedPath = (path) => `${pathPrefix}${path}`;
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';

const copy = isKorean
  ? {
      description: 'Journal, 대화, 영상 그리고 유용한 것들.',
      independentJournal: 'Journal',
      ideasMediaProducts: '아이디어 → 미디어 → 제품',
      heroTitle: '발전시킬 가치가\n있는 아이디어.',
      heroCopy: '아이디어는 글쓰기에서 시작합니다. 가장 강한 아이디어는 대화, 영상 그리고 유용한 제품으로 성장합니다.',
      exploreJournal: 'Journal 둘러보기 →',
      featuredJournal: '주요 Journal',
      featuredFallback: '더 오래 생각해 볼 가치가 있는 아이디어입니다.',
      readArticle: '글 읽기 →',
      noJournal: '아직 발행된 Journal 항목이 없습니다.',
      latestJournal: '최근 Journal',
      viewAll: '모두 보기 →',
      moreJournal: '새로운 Journal 항목이 이곳에 표시됩니다.',
      podcast: '팟캐스트',
      podcastFallback: '대화를 통해 더 깊이 들어갑니다.',
      podcastCopy: '더 많은 공간이 필요한 아이디어를 긴 대화로 살펴봅니다.',
      explorePodcast: '팟캐스트 둘러보기 →',
      youtube: '유튜브',
      youtubeFallback: '아이디어가 형태를 갖추는 과정을 봅니다.',
      youtubeCopy: '시각적 설명, 실험, 그리고 만들어지고 있는 것들입니다.',
      exploreYoutube: '유튜브 둘러보기 →',
      apps: '앱',
      appsFallback: '실제 문제에서 출발한 유용한 것들입니다.',
      appsCopy: '아이디어가 해결할 가치가 있는 문제를 가리킬 때 제품이 될 수 있습니다.',
      exploreApps: '앱 둘러보기 →',
      newsletter: '뉴스레터',
      newsletterTitle: '새로운 아이디어를\n가끔 전합니다.',
      newsletterCopy: '읽거나 보거나 사용해 볼 가치가 있는 것이 생기면 짧은 이메일을 보냅니다.',
      emailLabel: '이메일 주소',
      emailPlaceholder: '이메일 주소',
      subscribe: '구독하기 →',
      builtWithKit: 'Kit으로 제작',
      newsletterNote: '스팸은 보내지 않습니다. 언제든 구독을 해지할 수 있습니다.',
      about: '소개',
      aboutTitle: '글이 먼저입니다.\n다른 모든 것은\n그곳에서 자라납니다.',
      aboutCopyOne: '이 사이트는 글쓰기를 통해 아이디어가 시작되는 곳입니다. 어떤 아이디어는 대화, 영상 그리고 제품으로 성장합니다.',
      aboutCopyTwo: '글이 먼저입니다. 다른 모든 것은 더 발전시킬 가치가 있는 아이디어에서 시작됩니다.',
      aboutJack: 'Jack 소개 →',
    }
  : {
      description: 'Journal, conversations, videos and useful things.',
      independentJournal: 'Journal',
      ideasMediaProducts: 'Ideas → Media → Products',
      heroTitle: 'Ideas worth\ndeveloping.',
      heroCopy: 'Writing is where ideas begin. The strongest ones grow into conversations, videos and useful products.',
      exploreJournal: 'Explore Journal →',
      featuredJournal: 'Featured Journal',
      featuredFallback: 'An idea worth spending more time with.',
      readArticle: 'Read article →',
      noJournal: 'No published journal entries yet.',
      latestJournal: 'Latest Journal',
      viewAll: 'View all →',
      moreJournal: 'More journal entries will appear here.',
      podcast: 'Podcast',
      podcastFallback: 'Go deeper through conversation.',
      podcastCopy: 'Longer conversations around ideas that deserve more space.',
      explorePodcast: 'Explore Podcast →',
      youtube: 'YouTube',
      youtubeFallback: 'See the idea take shape.',
      youtubeCopy: 'Visual explanations, experiments and things being built.',
      exploreYoutube: 'Explore YouTube →',
      apps: 'Apps',
      appsFallback: 'Useful things built from real problems.',
      appsCopy: 'When an idea points to a problem worth solving, it may become a product.',
      exploreApps: 'Explore Apps →',
      newsletter: 'Newsletter',
      newsletterTitle: 'New ideas,\noccasionally.',
      newsletterCopy: 'A short email when there is something worth reading, watching or trying.',
      emailLabel: 'Email address',
      emailPlaceholder: 'Your email',
      subscribe: 'Subscribe →',
      builtWithKit: 'Built with Kit',
      newsletterNote: 'No spam. Unsubscribe whenever you want.',
      about: 'About',
      aboutTitle: 'Writing first.\nEverything else\ngrows from there.',
      aboutCopyOne: 'This site is where ideas start through writing. Some grow into conversations, videos and products.',
      aboutCopyTwo: 'The writing comes first. Everything else develops from the ideas worth taking further.',
      aboutJack: 'About Jack →',
    };

const journalEntries =
  (await getCollection('journal'))
    .filter(
      (post) => !post.data.draft && post.data.lang === lang
    )
    .sort(
      (a, b) =>
        b.data.date.valueOf() -
        a.data.date.valueOf()
    );

const podcasts =
  (await getCollection('podcast'))
    .filter(
      (post) => !post.data.draft && post.data.lang === lang
    )
    .sort(
      (a, b) =>
        b.data.date.valueOf() -
        a.data.date.valueOf()
    );

const videos =
  (await getCollection('youtube'))
    .filter(
      (post) => !post.data.draft && post.data.lang === lang
    )
    .sort(
      (a, b) =>
        b.data.date.valueOf() -
        a.data.date.valueOf()
    );

const apps =
  (await getCollection('apps'))
    .filter(
      (app) => !app.data.draft && app.data.lang === lang
    )
    .sort(
      (a, b) =>
        b.data.date.valueOf() -
        a.data.date.valueOf()
    );

const featuredJournalEntry =
  journalEntries.find(
    (post) =>
      post.data.featured
  ) ?? journalEntries[0];

const latestJournalEntries =
  journalEntries
    .filter(
      (post) =>
        post.id !==
        featuredJournalEntry?.id
    )
    .slice(0, 3);

const featuredPodcast =
  podcasts.find(
    (post) =>
      post.data.featured
  ) ?? podcasts[0];

const featuredVideo =
  videos.find(
    (post) =>
      post.data.featured
  ) ?? videos[0];

const featuredApp =
  apps.find(
    (app) =>
      app.data.featured
  ) ?? apps[0];
---

<BaseLayout
  title="Jack"
  description={copy.description}
  {lang}
  alternatePath={isKorean ? '/' : '/ko/'}
>

  <!-- SURFACE -->

  <section
    class="
      home-hero
      ocean-panel
    "
  >
    <div class="hero-top">
      <span>
        {copy.independentJournal}
      </span>

      <span>
        {copy.ideasMediaProducts}
      </span>
    </div>

    <h1>
      {copy.heroTitle.split('\n').map((line, index) => (
        <>{index > 0 && <br />}{line}</>
      ))}
    </h1>

    <div class="hero-bottom">
      <p>
        {copy.heroCopy}
      </p>

      <a href={localizedPath('/journal/')}>
        {copy.exploreJournal}
      </a>
    </div>
  </section>


  <!-- SHALLOW WATER -->

  <section
    class="
      home-section
      ocean-panel
      depth-1
    "
  >
    <div class="section-label">
      <span class="number">
        01
      </span>

      <span>
        {copy.featuredJournal}
      </span>
    </div>

    {featuredJournalEntry ? (
      <div class="featured-content">
        <h2>
          {featuredJournalEntry.data.title}
        </h2>

        <div class="featured-bottom">
          <p>
            {
              featuredJournalEntry.data.description ||
              copy.featuredFallback
            }
          </p>

          <a
            href={localizedPath(
              `/journal/${getPublicSlug(featuredJournalEntry.id, featuredJournalEntry.data.lang)}/`,
            )}
          >
            {copy.readArticle}
          </a>
        </div>
      </div>
    ) : (
      <p class="muted">
        {copy.noJournal}
      </p>
    )}
  </section>


  <!-- DESCENDING -->

  <section
    class="
      home-section
      ocean-panel
      depth-2
    "
  >
    <div
      class="
        section-label
        section-label-link
      "
    >
      <div>
        <span class="number">
          02
        </span>

        <span>
          {copy.latestJournal}
        </span>
      </div>

      <a href={localizedPath('/journal/')}>
        {copy.viewAll}
      </a>
    </div>

    {latestJournalEntries.length > 0 ? (
      <div class="journal-list">
        {latestJournalEntries.map(
          (post) => (
            <a
              href={localizedPath(
                `/journal/${getPublicSlug(post.id, post.data.lang)}/`,
              )}
              class="journal-row"
            >
              <div>
                <span class="post-date">
                  {
                    post.data.date
                      .toLocaleDateString(
                        dateLocale,
                        {
                          year:
                            'numeric',
                          month:
                            'short',
                          day:
                            'numeric',
                        }
                      )
                  }
                </span>

                <h3>
                  {post.data.title}
                </h3>
              </div>

              <span class="arrow">
                ↗
              </span>
            </a>
          )
        )}
      </div>
    ) : (
      <p class="muted">
        {copy.moreJournal}
      </p>
    )}
  </section>


  <!-- MID WATER -->

  <section class="formats">

    <div
      class="
        format
        ocean-panel
        depth-3
      "
    >
      <div class="section-label">
        <span class="number">
          03
        </span>

        <span>
          {copy.podcast}
        </span>
      </div>

      <h2>
        {
          featuredPodcast
            ? featuredPodcast.data.title
            : copy.podcastFallback
        }
      </h2>

      <p>
        {copy.podcastCopy}
      </p>

      <a href={localizedPath('/podcast/')}>
        {copy.explorePodcast}
      </a>
    </div>


    <div
      class="
        format
        ocean-panel
        depth-4
      "
    >
      <div class="section-label">
        <span class="number">
          04
        </span>

        <span>
          {copy.youtube}
        </span>
      </div>

      <h2>
        {
          featuredVideo
            ? featuredVideo.data.title
            : copy.youtubeFallback
        }
      </h2>

      <p>
        {copy.youtubeCopy}
      </p>

      <a href={localizedPath('/youtube/')}>
        {copy.exploreYoutube}
      </a>
    </div>

  </section>


  <!-- DEEP WATER -->

  <section
    class="
      home-section
      ocean-panel
      depth-5
    "
  >
    <div class="section-label">
      <span class="number">
        05
      </span>

      <span>
        {copy.apps}
      </span>
    </div>

    <div class="apps-layout">
      <h2>
        {
          featuredApp
            ? featuredApp.data.title
            : copy.appsFallback
        }
      </h2>

      <div class="side-copy">
        <p>
          {copy.appsCopy}
        </p>

        <a href={localizedPath('/apps/')}>
          {copy.exploreApps}
        </a>
      </div>
    </div>
  </section>


  <!-- NEWSLETTER -->

  <section
    class="
      newsletter
      ocean-panel
      depth-6
    "
    id="subscribe"
  >
    <div>
      <div class="section-label">
        <span class="number">
          06
        </span>

        <span>
          {copy.newsletter}
        </span>
      </div>

      <h2>
        {copy.newsletterTitle.split('\n').map((line, index) => (
          <>{index > 0 && <br />}{line}</>
        ))}
      </h2>
    </div>

    <div class="newsletter-right">
      <p>
        {copy.newsletterCopy}
      </p>

      <script
        is:inline
        src="https://f.convertkit.com/ckjs/ck.5.js"
      ></script>

      <form
        action="https://app.kit.com/forms/9892931/subscriptions"
        class="newsletter-form seva-form formkit-form"
        method="post"
        data-sv-form="9892931"
        data-uid="70f768a3ff"
        data-format="inline"
        data-version="5"
      >
        <ul
          class="formkit-alert formkit-alert-error"
          data-element="errors"
          data-group="alert"
        ></ul>

        <div
          class="newsletter-fields"
          data-element="fields"
          data-stacked="false"
        >
          <div class="newsletter-field">
            <label
              class="visually-hidden"
              for="newsletter-email"
            >
              {copy.emailLabel}
            </label>

            <input
              id="newsletter-email"
              class="formkit-input newsletter-input"
              name="email_address"
              type="email"
              placeholder={copy.emailPlaceholder}
              aria-label={copy.emailLabel}
              autocomplete="email"
              required
            />
          </div>

          <button
            class="formkit-submit newsletter-submit"
            type="submit"
            data-element="submit"
          >
            <span>
              {copy.subscribe}
            </span>
          </button>
        </div>

        <div
          class="newsletter-kit-branding"
        >
          <a
            href="https://kit.com/features/forms?utm_campaign=poweredby&utm_content=form&utm_medium=referral&utm_source=dynamic"
            target="_blank"
            rel="nofollow noopener"
          >
            {copy.builtWithKit}
          </a>
        </div>
      </form>

      <p class="newsletter-note">
        {copy.newsletterNote}
      </p>
    </div>
  </section>


  <!-- ABYSS -->

  <section
    class="
      home-section
      ocean-panel
      depth-7
      about-section
    "
  >
    <div class="section-label">
      <span class="number">
        07
      </span>

      <span>
        {copy.about}
      </span>
    </div>

    <div class="about-layout">
      <h2>
        {copy.aboutTitle.split('\n').map((line, index) => (
          <>{index > 0 && <br />}{line}</>
        ))}
      </h2>

      <div class="side-copy">
        <p>
          {copy.aboutCopyOne}
        </p>

        <p>
          {copy.aboutCopyTwo}
        </p>

        <a href={localizedPath('/about/')}>
          {copy.aboutJack}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>


<style is:global>

  /*
    GENERAL PANEL
  */

  .ocean-panel {
    width: 100%;

    border:
      1px solid var(--line);

    box-shadow:
      var(--shadow);
  }


  /*
    HERO / SURFACE
  */

  .home-hero {
    min-height: 84vh;

    display: flex;

    flex-direction: column;

    justify-content:
      space-between;

    padding: 64px;

    margin-bottom: 28px;

    background:
      linear-gradient(
        90deg,

        rgba(
          1,
          7,
          13,
          0.72
        ) 0%,

        rgba(
          1,
          7,
          13,
          0.46
        ) 38%,

        rgba(
          1,
          7,
          13,
          0.18
        ) 68%,

        rgba(
          1,
          7,
          13,
          0.12
        ) 100%
      );
  }

  .hero-top {
    display: flex;

    justify-content:
      space-between;

    gap: 20px;

    color: #e0e5eb;

    font-size: 0.8rem;

    font-weight: 700;

    letter-spacing:
      0.12em;

    text-transform:
      uppercase;

    text-shadow:
      0 2px 18px
      rgba(0, 0, 0, 0.9);
  }

  .home-hero h1 {
    max-width: 1120px;

    margin:
      80px 0 72px;

    text-shadow:
      0 6px 46px
      rgba(0, 0, 0, 0.92);
  }

  .hero-bottom {
    display: grid;

    grid-template-columns:
      minmax(
        0,
        580px
      )
      auto;

    justify-content:
      space-between;

    align-items: end;

    gap: 40px;
  }

  .hero-bottom p {
    margin: 0;

    color: #f0f2f5;

    font-size: 1.14rem;

    line-height: 1.75;

    text-shadow:
      0 3px 22px
      rgba(0, 0, 0, 0.95);
  }

  .hero-bottom a {
    font-weight: 700;

    text-shadow:
      0 3px 22px
      rgba(0, 0, 0, 0.95);
  }


  /*
    COMMON SECTION
  */

  .home-section {
    padding: 76px 64px;

    margin-top: 28px;
  }

  .section-label {
    display: flex;

    align-items: center;

    gap: 18px;

    margin-bottom: 58px;

    color: #cbd4dd;

    font-size: 0.82rem;

    font-weight: 700;

    letter-spacing:
      0.12em;

    text-transform:
      uppercase;
  }

  .number {
    display: inline-block;

    width: 30px;
  }

  .section-label-link {
    justify-content:
      space-between;
  }

  .section-label-link > div {
    display: flex;

    align-items: center;

    gap: 18px;
  }

  .section-label-link > a {
    color: var(--text);

    letter-spacing: 0;

    text-transform: none;
  }


  /*
    DEPTH SYSTEM
  */

  .depth-1 {
    background:
      linear-gradient(
        180deg,
        rgba(
          5,
          20,
          38,
          0.28
        ),
        rgba(
          4,
          17,
          33,
          0.36
        )
      );
  }

  .depth-2 {
    background:
      linear-gradient(
        180deg,
        rgba(
          4,
          17,
          33,
          0.38
        ),
        rgba(
          3,
          15,
          30,
          0.46
        )
      );
  }

  .depth-3 {
    background:
      linear-gradient(
        180deg,
        rgba(
          3,
          15,
          30,
          0.48
        ),
        rgba(
          2,
          13,
          27,
          0.58
        )
      );
  }

  .depth-4 {
    background:
      linear-gradient(
        180deg,
        rgba(
          2,
          13,
          27,
          0.58
        ),
        rgba(
          1,
          10,
          22,
          0.69
        )
      );
  }

  .depth-5 {
    background:
      linear-gradient(
        180deg,
        rgba(
          1,
          11,
          24,
          0.66
        ),
        rgba(
          1,
          8,
          19,
          0.77
        )
      );
  }

  .depth-6 {
    background:
      linear-gradient(
        180deg,
        rgba(
          1,
          9,
          21,
          0.76
        ),
        rgba(
          0,
          6,
          15,
          0.87
        )
      );
  }

  .depth-7 {
    background:
      linear-gradient(
        180deg,
        rgba(
          0,
          6,
          15,
          0.86
        ),
        rgba(
          0,
          3,
          8,
          0.95
        )
      );
  }


  /*
    FEATURED JOURNAL
  */

  .featured-content h2 {
    max-width: 1120px;

    margin-bottom: 72px;
  }

  .featured-bottom {
    display: grid;

    grid-template-columns:
      minmax(
        0,
        580px
      )
      auto;

    justify-content:
      space-between;

    align-items: end;

    gap: 40px;
  }

  .featured-bottom p {
    margin: 0;

    color: var(--muted);

    font-size: 1.05rem;
  }

  .featured-bottom a {
    font-weight: 700;
  }


  /*
    JOURNAL LIST
  */

  .journal-list {
    border-top:
      1px solid var(--line);
  }

  .journal-row {
    display: grid;

    grid-template-columns:
      1fr auto;

    align-items: center;

    gap: 20px;

    padding: 34px 0;

    border-bottom:
      1px solid var(--line);
  }

  .journal-row:hover {
    color: var(--accent);
  }

  .journal-row h3 {
    margin-bottom: 0;
  }

  .post-date {
    display: block;

    margin-bottom: 8px;

    color: var(--muted);

    font-size: 0.86rem;
  }

  .arrow {
    color: var(--muted);

    font-size: 1.8rem;
  }


  /*
    PODCAST + YOUTUBE
  */

  .formats {
    width: 100%;

    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 28px;

    margin-top: 28px;
  }

  .format {
    min-height: 580px;

    padding: 76px 64px;
  }

  .format h2 {
    max-width: 580px;
  }

  .format p {
    max-width: 470px;

    margin-top: 42px;

    color: var(--muted);

    font-size: 1.05rem;
  }

  .format a {
    display: inline-block;

    margin-top: 20px;

    font-weight: 700;
  }


  /*
    APPS
  */

  .apps-layout {
    display: grid;

    grid-template-columns:
      1.5fr 0.6fr;

    align-items: end;

    gap: 100px;
  }

  .apps-layout h2 {
    max-width: 920px;

    margin-bottom: 0;
  }

  .side-copy {
    max-width: 440px;
  }

  .side-copy p {
    color: #d1d9e1;

    font-size: 1.05rem;
  }

  .side-copy a {
    font-weight: 700;
  }


  /*
    NEWSLETTER
  */

  .newsletter {
    display: grid;

    grid-template-columns:
      1.2fr 0.8fr;

    align-items: end;

    gap: 100px;

    padding: 76px 64px;

    margin-top: 28px;
  }

  .newsletter h2 {
    margin-bottom: 0;
  }

  .newsletter-right p {
    max-width: 450px;

    color: #dce2e9;

    font-size: 1.05rem;
  }

  .newsletter-form {
