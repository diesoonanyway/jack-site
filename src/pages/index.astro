---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicSlug } from '../lib/content-slug';
import { sortByCreatedAt } from '../lib/content-sort';
import { getYouTubeThumbnailUrl } from '../lib/youtube';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const localizedPath = (path) => `${pathPrefix}${path}`;
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';

const copy = isKorean
  ? {
      description: '읽고, 듣고, 볼 수 있는 이야기.',
      heroEyebrow: 'IF IT ALL ENDS',
      heroTitle: '발전시킬 가치가\n있는 아이디어.',
      heroCta: 'Stories 둘러보기 →',
      stories: '스토리',
      readArticle: '글 읽기 →',
      noStories: '아직 발행된 스토리가 없습니다.',
      viewAll: '모두 보기 →',
      recentStories: '최근 스토리',
      previousStories: '이전 스토리',
      nextStories: '다음 스토리',
      newsletter: '뉴스레터',
      newsletterTitle: '새로운 아이디어를\n가끔 전합니다.',
      newsletterCopy: '읽거나 보거나 사용해 볼 가치가 있는 것이 생기면 짧은 이메일을 보냅니다.',
      emailLabel: '이메일 주소',
      emailPlaceholder: '이메일 주소',
      subscribe: '구독하기 →',
      newsletterNote: '스팸은 보내지 않습니다. 언제든 구독을 해지할 수 있습니다.',
      about: '소개',
      aboutTitle: '글이 먼저입니다.\n다른 모든 것은\n그곳에서 자라납니다.',
      aboutCopyOne: '이 사이트는 글쓰기를 통해 아이디어가 시작되는 곳입니다. 어떤 아이디어는 대화, 영상 그리고 제품으로 성장합니다.',
      aboutCopyTwo: '글이 먼저입니다. 다른 모든 것은 더 발전시킬 가치가 있는 아이디어에서 시작됩니다.',
      aboutJack: 'Jack 소개 →',
    }
  : {
      description: 'Stories to read, listen to and watch.',
      heroEyebrow: 'IF IT ALL ENDS',
      heroTitle: 'A Korean writer studying what it means to remain human in a faster, smarter world. If it all ends anyway...',
      heroCta: 'Explore ↓',
      stories: 'Stories',
      readArticle: 'Read article →',
      noStories: 'No published stories yet.',
      viewAll: 'View all →',
      recentStories: 'Recent Stories',
      previousStories: 'Previous stories',
      nextStories: 'Next stories',
      newsletter: 'Newsletter',
      newsletterTitle: 'New ideas,\noccasionally.',
      newsletterCopy: 'A short email when there is something worth reading, watching or trying.',
      emailLabel: 'Email address',
      emailPlaceholder: 'Your email',
      subscribe: 'Subscribe →',
      newsletterNote: 'No spam. Unsubscribe whenever you want.',
      about: 'About',
      aboutTitle: 'Writing first.\nEverything else\ngrows from there.',
      aboutCopyOne: 'This site is where ideas start through writing. Some grow into conversations, videos and products.',
      aboutCopyTwo: 'The writing comes first. Everything else develops from the ideas worth taking further.',
      aboutJack: 'About Jack →',
    };

const stories =
  sortByCreatedAt((await getCollection('stories'))
    .filter(
      (post) => !post.data.draft && post.data.lang === lang
    ));

const featuredStory = stories.find((story) => story.data.featured) ?? stories[0];
const recentStories = featuredStory
  ? stories.filter((story) => story.id !== featuredStory.id)
  : [];

const storyPath = (story) => localizedPath(`/stories/${getPublicSlug(story.id, story.data.lang)}/`);
const storyVisual = (story) => story.data.heroImage || getYouTubeThumbnailUrl(story.data.youtubeUrl);
const storyFormats = (story) => [
  'READ',
  story.data.spotifyUrl ? 'LISTEN' : null,
  story.data.youtubeUrl ? 'WATCH' : null,
].filter(Boolean).join(' · ');
---

<BaseLayout
  title="Jack"
  description={copy.description}
  {lang}
  alternatePath={isKorean ? '/' : '/ko/'}
>
  <section class="home-hero">
    <div class="hero-top">
      <span>{copy.heroEyebrow}</span>
    </div>

    <h1 class={isKorean ? 'editorial-title' : 'editorial-title site-intro-title'}>
      {copy.heroTitle.split('\n').map((line, index) => (
        <>{index > 0 && <br />}{line}</>
      ))}
    </h1>

    <div class="hero-bottom hero-bottom--single">
      <a href="#featured-story">{copy.heroCta}</a>
    </div>
  </section>

  <div class="home-content-sections">
    {featuredStory ? (
      <section
        class="home-section featured-story"
        id="featured-story"
      >
        {storyVisual(featuredStory) && (
          <a
            class="featured-visual"
            href={storyPath(featuredStory)}
            aria-label={featuredStory.data.title}
          >
            <img
              src={storyVisual(featuredStory)}
              alt=""
              loading="eager"
            />
            {featuredStory.data.youtubeUrl && (
              <span class="play-cue" aria-hidden="true">▶</span>
            )}
          </a>
        )}

        <div class:list={['featured-copy', { 'featured-copy--text-only': !storyVisual(featuredStory) }]}>
          <p class="story-formats">{storyFormats(featuredStory)}</p>
          <h2 class="editorial-title">
            <a href={storyPath(featuredStory)}>{featuredStory.data.title}</a>
          </h2>
          {featuredStory.data.description && (
            <p class="featured-description">{featuredStory.data.description}</p>
          )}
          <time datetime={featuredStory.data.date.toISOString()}>
            {featuredStory.data.date.toLocaleDateString(dateLocale, {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </div>
      </section>
    ) : (
      <section class="home-section" id="featured-story">
        <p class="muted">{copy.noStories}</p>
      </section>
    )}

    {recentStories.length > 0 && (
      <section class="home-section recent-stories" data-carousel>
        <div class="section-heading-row">
          <h2 class="section-heading">{copy.recentStories}</h2>
          <a href={localizedPath('/stories/')}>{copy.viewAll}</a>
        </div>

        <div class="media-rail-frame">
          <div class="media-rail-controls" hidden>
            <button type="button" data-carousel-direction="previous" aria-label={copy.previousStories}>←</button>
            <button type="button" data-carousel-direction="next" aria-label={copy.nextStories}>→</button>
          </div>

          <div
            class="media-rail"
            role="region"
            aria-roledescription="carousel"
            aria-label={copy.recentStories}
            data-carousel-track
          >
            {recentStories.map((story) => (
              <article class="media-rail-item story-rail-item">
                {storyVisual(story) && (
                  <a
                    class="story-rail-visual"
                    href={storyPath(story)}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <img src={storyVisual(story)} alt="" loading="lazy" />
                    {story.data.youtubeUrl && (
                      <span class="play-cue play-cue--small" aria-hidden="true">▶</span>
                    )}
                  </a>
                )}
                <p class="story-formats">{storyFormats(story)}</p>
                <h3 class="media-card-title">
                  <a class="media-card-link" href={storyPath(story)}>{story.data.title}</a>
                </h3>
                {story.data.description && <p class="story-card-description">{story.data.description}</p>}
                <time datetime={story.data.date.toISOString()}>
                  {story.data.date.toLocaleDateString(dateLocale, {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}


  <!-- NEWSLETTER -->

  <section
    class="
      newsletter
      home-section
      home-flow-section
    "
    id="subscribe"
  >
    <div>
      <div class="section-label">
        <span>
          {copy.newsletter}
        </span>
      </div>

      <h2 class="editorial-title">
        {copy.newsletterTitle.split('\n').map((line, index) => (
          <>{index > 0 && <br />}{line}</>
        ))}
      </h2>
    </div>

    <div class="newsletter-right">
      <p>
        {copy.newsletterCopy}
      </p>

      <script
        is:inline
        src="https://f.convertkit.com/ckjs/ck.5.js"
      ></script>

      <form
        action="https://app.kit.com/forms/9892931/subscriptions"
        class="newsletter-form seva-form formkit-form"
        method="post"
        data-sv-form="9892931"
        data-uid="70f768a3ff"
        data-format="inline"
        data-version="5"
      >
        <ul
          class="formkit-alert formkit-alert-error"
          data-element="errors"
          data-group="alert"
        ></ul>

        <div
          class="newsletter-fields"
          data-element="fields"
          data-stacked="false"
        >
          <div class="newsletter-field">
            <label
              class="visually-hidden"
              for="newsletter-email"
            >
              {copy.emailLabel}
            </label>

            <input
              id="newsletter-email"
              class="formkit-input newsletter-input"
              name="email_address"
              type="email"
              placeholder={copy.emailPlaceholder}
              aria-label={copy.emailLabel}
              autocomplete="email"
              required
            />
          </div>

          <button
            class="formkit-submit newsletter-submit"
            type="submit"
            data-element="submit"
          >
            <span>
              {copy.subscribe}
            </span>
          </button>
        </div>

      </form>

      <p class="newsletter-note">
        {copy.newsletterNote}
      </p>
    </div>
  </section>


  <!-- ABYSS -->

  <section
    class="
      home-section
      home-flow-section
      about-section
    "
  >
    <div class="section-label">
      <span>
        {copy.about}
      </span>
    </div>

    <div class="about-layout">
      <h2 class="editorial-title">
        {copy.aboutTitle.split('\n').map((line, index) => (
          <>{index > 0 && <br />}{line}</>
        ))}
      </h2>

      <div class="side-copy">
        <p>
          {copy.aboutCopyOne}
        </p>

        <p>
          {copy.aboutCopyTwo}
        </p>

        <a href={localizedPath('/about/')}>
          {copy.aboutJack}
        </a>
      </div>
    </div>
  </section>

  </div>

  {!isKorean && (
    <div class="newsletter-modal" data-newsletter-modal hidden>
      <div
        class="newsletter-modal-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="newsletter-modal-title"
      >
        <button
          class="newsletter-modal-close"
          type="button"
          data-newsletter-close
          aria-label="Close newsletter signup"
        >
          &times;
        </button>
        <p class="newsletter-modal-label">{copy.newsletter}</p>
        <h2 id="newsletter-modal-title" class="editorial-title">
          If it all ends anyway, what is still worth paying attention to?
        </h2>
        <p class="newsletter-modal-description">
          Occasional letters for people who still like to think slowly — about what it means to stay human, keep learning, and notice what still matters as the world keeps accelerating.
        </p>
        <div data-newsletter-form-slot></div>
        <p class="newsletter-note">{copy.newsletterNote}</p>
      </div>
    </div>
  )}
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const frame = carousel.querySelector<HTMLElement>('.media-rail-frame');
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const controls = carousel.querySelector<HTMLElement>('.media-rail-controls');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-direction="previous"]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-direction="next"]');
    if (!frame || !track || !controls || !previous || !next) return;

    const updateControls = () => {
      const overflow = track.scrollWidth > track.clientWidth + 2;
      controls.hidden = !overflow;
      frame.classList.toggle('has-controls', overflow);
      const canGoPrevious = overflow && track.scrollLeft > 2;
      const canGoNext = overflow && track.scrollLeft + track.clientWidth < track.scrollWidth - 2;
      previous.disabled = !canGoPrevious;
      next.disabled = !canGoNext;
      track.classList.toggle('fade-left', canGoPrevious);
      track.classList.toggle('fade-right', canGoNext);
    };

    const move = (direction: number) => {
      const card = track.querySelector<HTMLElement>('.media-rail-item');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const distance = (card?.getBoundingClientRect().width ?? track.clientWidth) + gap;
      track.scrollBy({
        left: direction * distance,
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', updateControls, { passive: true });
    new ResizeObserver(updateControls).observe(track);
    updateControls();
  });

  const modal = document.querySelector<HTMLElement>('[data-newsletter-modal]');
  const form = document.querySelector<HTMLFormElement>('#subscribe .newsletter-form');
  const formSlot = modal?.querySelector<HTMLElement>('[data-newsletter-form-slot]');
  const closeButton = modal?.querySelector<HTMLButtonElement>('[data-newsletter-close]');
  const panel = modal?.querySelector<HTMLElement>('[role="dialog"]');

  if (modal && form && formSlot && closeButton && panel) {
    const dismissedUntilKey = 'jack-site:newsletter-modal:dismissed-until';
    const subscribedKey = 'jack-site:newsletter-modal:subscribed';
    const dismissDuration = 30 * 24 * 60 * 60 * 1000;
    const originalParent = form.parentNode;
    const originalNextSibling = form.nextSibling;
    let previousFocus: HTMLElement | null = null;
    let previousBodyOverflow = '';
    let submitted = false;
    let closing = false;

    const readStorage = (key: string) => {
      try { return localStorage.getItem(key); }
      catch { return null; }
    };

    const writeStorage = (key: string, value: string) => {
      try { localStorage.setItem(key, value); }
      catch { /* Storage can be unavailable in private browsing. */ }
    };

    form.addEventListener('submit', () => {
      submitted = form.checkValidity();
    });

    const successObserver = new MutationObserver(() => {
      if (!submitted) return;
      const success = panel.querySelector<HTMLElement>('.formkit-alert-success, [data-element="success"]');
      if (success?.textContent?.trim() && success.getClientRects().length > 0) {
        writeStorage(subscribedKey, 'true');
        successObserver.disconnect();
      }
    });

    const closeModal = () => {
      if (modal.hidden || closing) return;
      closing = true;
      writeStorage(dismissedUntilKey, String(Date.now() + dismissDuration));
      modal.classList.remove('is-open');
      window.setTimeout(() => {
        modal.hidden = true;
        if (originalParent) originalParent.insertBefore(form, originalNextSibling);
        successObserver.disconnect();
        document.body.style.overflow = previousBodyOverflow;
        previousFocus?.focus();
      }, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 260);
    };

    closeButton.addEventListener('click', closeModal);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
    document.addEventListener('keydown', (event) => {
      if (modal.hidden) return;
      if (event.key === 'Escape') closeModal();
      if (event.key !== 'Tab') return;
      const focusable = [...panel.querySelectorAll<HTMLElement>('input, button, a[href]')]
        .filter((element) => !element.hasAttribute('disabled') && element.getClientRects().length > 0);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });

    if (readStorage(subscribedKey) !== 'true' && Date.now() >= Number(readStorage(dismissedUntilKey) || 0)) {
      window.setTimeout(() => {
        if (readStorage(subscribedKey) === 'true' || Date.now() < Number(readStorage(dismissedUntilKey) || 0)) return;
        previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        previousBodyOverflow = document.body.style.overflow;
        formSlot.append(form);
        successObserver.observe(panel, { subtree: true, childList: true, characterData: true, attributes: true });
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => modal.classList.add('is-open'));
        closeButton.focus();
      }, 1000);
    }
  }
</script>


<style is:global>
  .home-hero,
  .home-content-sections > .home-section {
    --home-content-inline-padding: 64px;
  }

  /*
    HERO / SURFACE
  */

  .home-hero {
    position: relative;
    isolation: isolate;
    min-height: 84vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: 64px var(--home-content-inline-padding);
  }

  .home-hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(1, 7, 13, 0.72) 0%,
        rgba(1, 7, 13, 0.46) 38%,
        rgba(1, 7, 13, 0.18) 68%,
        rgba(1, 7, 13, 0.12) 100%
      );
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #e0e5eb;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.9);
  }

  .home-hero h1 {
    max-width: 1120px;
    margin: 80px 0 72px;
    text-shadow: 0 6px 46px rgba(0, 0, 0, 0.92);
  }

  .home-hero .site-intro-title {
    font-size: clamp(2.9rem, 4.5vw, 4.8rem);
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 580px) auto;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
  }

  .hero-bottom p {
    margin: 0;
    color: #f0f2f5;
    font-size: 1.14rem;
    line-height: 1.75;
    text-shadow: 0 3px 22px rgba(0, 0, 0, 0.95);
  }

  .hero-bottom a {
    font-weight: 700;
    text-shadow: 0 3px 22px rgba(0, 0, 0, 0.95);
  }

  .hero-bottom--single {
    display: flex;
    justify-content: flex-end;
  }

  /*
    EDITORIAL FLOW
  */

  .home-content-sections > .home-section {
    --section-heading-color: #c9d4db;
    --section-divider: 183, 201, 214;
    position: relative;
    isolation: isolate;
    width: 100%;
    margin-inline: auto;
    padding-block: 84px;
    padding-inline: var(--home-content-inline-padding);
  }

  /* Only rendered sections below the hero participate in this sequence. */
  .home-content-sections > .home-section:nth-of-type(odd) {
    --section-tint: 42, 74, 99;
  }

  .home-content-sections > .home-section:nth-of-type(even) {
    --section-tint: 8, 20, 34;
  }

  .home-content-sections > .home-section::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(var(--section-tint), 0.12),
      rgba(var(--section-tint), 0.4) 20%,
      rgba(var(--section-tint), 0.4) 80%,
      rgba(var(--section-tint), 0.12)
    );
  }

  .home-content-sections > .home-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--home-content-inline-padding);
    right: var(--home-content-inline-padding);
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent 0%,
        rgba(var(--section-divider), 0.1) 12%,
        rgba(var(--section-divider), 0.22) 50%,
        rgba(var(--section-divider), 0.1) 88%,
        transparent 100%
      );
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 58px;
    color: var(--section-heading-color);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-heading {
    margin-bottom: 58px;
    color: var(--section-heading-color);
    font-family: var(--font-editorial);
    font-size: clamp(2rem, 3vw, 2.6rem);
    font-weight: var(--editorial-title-weight);
    line-height: var(--editorial-title-leading);
    letter-spacing: var(--editorial-title-tracking);
  }

  .section-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 58px;
  }

  .section-heading-row .section-heading {
    margin-bottom: 0;
  }

  .section-heading-row > a {
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
  }

  /*
    FEATURED STORY
  */

  .featured-story {
    display: grid;
    gap: clamp(42px, 6vw, 88px);
  }

  .featured-visual {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    background: rgba(1, 8, 15, 0.5);
  }

  .featured-visual img,
  .story-rail-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-copy {
    max-width: 1050px;
  }

  .featured-copy--text-only {
    padding-block: clamp(54px, 7vw, 110px);
  }

  .featured-copy h2 {
    max-width: 1000px;
    margin: 22px 0 28px;
    font-size: clamp(3rem, 6vw, 6.6rem);
  }

  .featured-description {
    max-width: 760px;
    margin-bottom: 28px;
    color: var(--body-text);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.75;
  }

  .featured-copy time,
  .story-formats {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .play-cue {
    position: absolute;
    right: 28px;
    bottom: 28px;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 1px solid rgba(246, 244, 239, 0.42);
    border-radius: 50%;
    color: var(--text);
    background: rgba(1, 8, 15, 0.66);
    font-size: 0.88rem;
    pointer-events: none;
  }

  /*
    RECENT STORIES RAIL
  */

