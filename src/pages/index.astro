---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicSlug } from '../lib/content-slug';
import { getYouTubeThumbnailUrl } from '../lib/youtube';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const localizedPath = (path) => `${pathPrefix}${path}`;
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';

const copy = isKorean
  ? {
      description: 'Journal, 대화, 영상 그리고 유용한 것들.',
      independentJournal: 'Journal',
      ideasMediaProducts: '아이디어 → 미디어 → 제품',
      heroTitle: '발전시킬 가치가\n있는 아이디어.',
      heroCopy: '아이디어는 글쓰기에서 시작합니다. 가장 강한 아이디어는 대화, 영상 그리고 유용한 제품으로 성장합니다.',
      exploreJournal: 'Journal 둘러보기 →',
      featuredJournal: '주요 Journal',
      featuredFallback: '더 오래 생각해 볼 가치가 있는 아이디어입니다.',
      readArticle: '글 읽기 →',
      noJournal: '아직 발행된 Journal 항목이 없습니다.',
      latestJournal: '최근 Journal',
      viewAll: '모두 보기 →',
      moreJournal: '새로운 Journal 항목이 이곳에 표시됩니다.',
      podcast: '팟캐스트',
      listenSpotify: 'Spotify에서 듣기 →',
      previousPodcasts: '이전 팟캐스트',
      nextPodcasts: '다음 팟캐스트',
      youtube: '유튜브',
      previousVideos: '이전 동영상',
      nextVideos: '다음 동영상',
      apps: '앱',
      appsFallback: '실제 문제에서 출발한 유용한 것들입니다.',
      appsCopy: '아이디어가 해결할 가치가 있는 문제를 가리킬 때 제품이 될 수 있습니다.',
      exploreApps: '앱 둘러보기 →',
      newsletter: '뉴스레터',
      newsletterTitle: '새로운 아이디어를\n가끔 전합니다.',
      newsletterCopy: '읽거나 보거나 사용해 볼 가치가 있는 것이 생기면 짧은 이메일을 보냅니다.',
      emailLabel: '이메일 주소',
      emailPlaceholder: '이메일 주소',
      subscribe: '구독하기 →',
      newsletterNote: '스팸은 보내지 않습니다. 언제든 구독을 해지할 수 있습니다.',
      about: '소개',
      aboutTitle: '글이 먼저입니다.\n다른 모든 것은\n그곳에서 자라납니다.',
      aboutCopyOne: '이 사이트는 글쓰기를 통해 아이디어가 시작되는 곳입니다. 어떤 아이디어는 대화, 영상 그리고 제품으로 성장합니다.',
      aboutCopyTwo: '글이 먼저입니다. 다른 모든 것은 더 발전시킬 가치가 있는 아이디어에서 시작됩니다.',
      aboutJack: 'Jack 소개 →',
    }
  : {
      description: 'Journal, conversations, videos and useful things.',
      independentJournal: 'Journal',
      ideasMediaProducts: 'Ideas → Media → Products',
      heroTitle: 'Ideas worth\ndeveloping.',
      heroCopy: 'Writing is where ideas begin. The strongest ones grow into conversations, videos and useful products.',
      exploreJournal: 'Explore Journal →',
      featuredJournal: 'Featured Journal',
      featuredFallback: 'An idea worth spending more time with.',
      readArticle: 'Read article →',
      noJournal: 'No published journal entries yet.',
      latestJournal: 'Latest Journal',
      viewAll: 'View all →',
      moreJournal: 'More journal entries will appear here.',
      podcast: 'Podcast',
      listenSpotify: 'Listen on Spotify →',
      previousPodcasts: 'Previous podcasts',
      nextPodcasts: 'Next podcasts',
      youtube: 'YouTube',
      previousVideos: 'Previous videos',
      nextVideos: 'Next videos',
      apps: 'Apps',
      appsFallback: 'Useful things built from real problems.',
      appsCopy: 'When an idea points to a problem worth solving, it may become a product.',
      exploreApps: 'Explore Apps →',
      newsletter: 'Newsletter',
      newsletterTitle: 'New ideas,\noccasionally.',
      newsletterCopy: 'A short email when there is something worth reading, watching or trying.',
      emailLabel: 'Email address',
      emailPlaceholder: 'Your email',
      subscribe: 'Subscribe →',
      newsletterNote: 'No spam. Unsubscribe whenever you want.',
      about: 'About',
      aboutTitle: 'Writing first.\nEverything else\ngrows from there.',
      aboutCopyOne: 'This site is where ideas start through writing. Some grow into conversations, videos and products.',
      aboutCopyTwo: 'The writing comes first. Everything else develops from the ideas worth taking further.',
      aboutJack: 'About Jack →',
    };

const journalEntries =
  (await getCollection('journal'))
    .filter(
      (post) => !post.data.draft && post.data.lang === lang
    )
    .sort(
      (a, b) =>
        b.data.date.valueOf() -
        a.data.date.valueOf()
    );

const podcasts =
  (await getCollection('podcast'))
    .filter(
      (post) => !post.data.draft && post.data.lang === lang
    )
    .sort(
      (a, b) =>
        b.data.date.valueOf() -
        a.data.date.valueOf()
    );

const videos =
  (await getCollection('youtube'))
    .filter(
      (post) => !post.data.draft && post.data.lang === lang
    )
    .sort(
      (a, b) =>
        b.data.date.valueOf() -
        a.data.date.valueOf()
    );

const apps =
  (await getCollection('apps'))
    .filter(
      (app) => !app.data.draft && app.data.lang === lang
    )
    .sort(
      (a, b) =>
        b.data.date.valueOf() -
        a.data.date.valueOf()
    );

const featuredJournalEntry =
  journalEntries.find(
    (post) =>
      post.data.featured
  ) ?? journalEntries[0];

const latestJournalEntries =
  journalEntries
    .filter(
      (post) =>
        post.id !==
        featuredJournalEntry?.id
    )
    .slice(0, 3);

const featuredPodcast =
  podcasts.find(
    (post) =>
      post.data.featured
  ) ?? podcasts[0];

const featuredVideo =
  videos.find(
    (post) =>
      post.data.featured
  ) ?? videos[0];

const podcastRail = featuredPodcast
  ? [featuredPodcast, ...podcasts.filter((post) => post.id !== featuredPodcast.id)]
  : podcasts;

const videoRail = featuredVideo
  ? [featuredVideo, ...videos.filter((post) => post.id !== featuredVideo.id)]
  : videos;

const featuredApp =
  apps.find(
    (app) =>
      app.data.featured
  ) ?? apps[0];
---

<BaseLayout
  title="Jack"
  description={copy.description}
  {lang}
  alternatePath={isKorean ? '/' : '/ko/'}
>

  <!-- SURFACE -->

  <section
    class="
      home-hero
    "
  >
    <div class="hero-top">
      <span>
        {copy.independentJournal}
      </span>

      <span>
        {copy.ideasMediaProducts}
      </span>
    </div>

    <h1>
      {copy.heroTitle.split('\n').map((line, index) => (
        <>{index > 0 && <br />}{line}</>
      ))}
    </h1>

    <div class="hero-bottom">
      <p>
        {copy.heroCopy}
      </p>

      <a href={localizedPath('/journal/')}>
        {copy.exploreJournal}
      </a>
    </div>
  </section>


  <!-- SHALLOW WATER -->

  <section
    class="
      home-section
      home-flow-section
    "
  >
    <div class="section-label">
      <span class="number">
        01
      </span>

      <span>
        {copy.featuredJournal}
      </span>
    </div>

    {featuredJournalEntry ? (
      <div class="featured-content">
        <h2>
          {featuredJournalEntry.data.title}
        </h2>

        <div class="featured-bottom">
          <p>
            {
              featuredJournalEntry.data.description ||
              copy.featuredFallback
            }
          </p>

          <a
            href={localizedPath(
              `/journal/${getPublicSlug(featuredJournalEntry.id, featuredJournalEntry.data.lang)}/`,
            )}
          >
            {copy.readArticle}
          </a>
        </div>
      </div>
    ) : (
      <p class="muted">
        {copy.noJournal}
      </p>
    )}
  </section>


  <!-- DESCENDING -->

  <section
    class="
      home-section
      home-flow-section
    "
  >
    <div
      class="
        section-label
        section-label-link
      "
    >
      <div>
        <span class="number">
          02
        </span>

        <span>
          {copy.latestJournal}
        </span>
      </div>

      <a href={localizedPath('/journal/')}>
        {copy.viewAll}
      </a>
    </div>

    {latestJournalEntries.length > 0 ? (
      <div class="journal-list">
        {latestJournalEntries.map(
          (post) => (
            <a
              href={localizedPath(
                `/journal/${getPublicSlug(post.id, post.data.lang)}/`,
              )}
              class="journal-row"
            >
              <div>
                <span class="post-date">
                  {
                    post.data.date
                      .toLocaleDateString(
                        dateLocale,
                        {
                          year:
                            'numeric',
                          month:
                            'short',
                          day:
                            'numeric',
                        }
                      )
                  }
                </span>

                <h3>
                  {post.data.title}
                </h3>
              </div>

              <span class="arrow">
                ↗
              </span>
            </a>
          )
        )}
      </div>
    ) : (
      <p class="muted">
        {copy.moreJournal}
      </p>
    )}
  </section>


  <!-- MID WATER -->

  {podcastRail.length > 0 && (
    <section class="home-section home-flow-section media-section" data-carousel>
      <div class="media-section-heading">
        <div class="section-label">
          <span class="number">03</span>
          <span>{copy.podcast}</span>
        </div>
      </div>

      <div class="media-rail-frame">
        <div class="media-rail-controls" hidden>
          <button type="button" data-carousel-direction="previous" aria-label={copy.previousPodcasts}>←</button>
          <button type="button" data-carousel-direction="next" aria-label={copy.nextPodcasts}>→</button>
        </div>
        <div class="media-rail podcast-rail" role="region" aria-roledescription="carousel" aria-label={copy.podcast} data-carousel-track>
        {podcastRail.map((post) => (
          <article class="media-rail-item podcast-rail-item">
            {post.data.episode && <span class="media-episode">EP. {post.data.episode}</span>}
            <h2>
              <a class="media-card-link" href={localizedPath(`/podcast/${getPublicSlug(post.id, post.data.lang)}/`)}>
                {post.data.title}
              </a>
            </h2>
            {post.data.description && <p>{post.data.description}</p>}
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            {post.data.audioUrl && (
              <a class="media-external-link" href={post.data.audioUrl} target="_blank" rel="noopener noreferrer">
                {copy.listenSpotify}
              </a>
            )}
          </article>
        ))}
        </div>
      </div>
    </section>
  )}

  {videoRail.length > 0 && (
    <section class="home-section home-flow-section media-section" data-carousel>
      <div class="media-section-heading">
        <div class="section-label">
          <span class="number">04</span>
          <span>{copy.youtube}</span>
        </div>
      </div>

      <div class="media-rail-frame">
        <div class="media-rail-controls" hidden>
          <button type="button" data-carousel-direction="previous" aria-label={copy.previousVideos}>←</button>
          <button type="button" data-carousel-direction="next" aria-label={copy.nextVideos}>→</button>
        </div>
        <div class="media-rail youtube-rail" role="region" aria-roledescription="carousel" aria-label={copy.youtube} data-carousel-track>
        {videoRail.map((post) => {
          const thumbnail = getYouTubeThumbnailUrl(post.data.youtubeId);
          return (
            <article class="media-rail-item youtube-rail-item">
              {thumbnail && (
                <a class="media-thumbnail" href={localizedPath(`/youtube/${getPublicSlug(post.id, post.data.lang)}/`)} tabIndex={-1} aria-hidden="true">
                  <img src={thumbnail} alt="" loading="lazy" width="480" height="360" />
                </a>
              )}
              <h2>
                <a class="media-card-link" href={localizedPath(`/youtube/${getPublicSlug(post.id, post.data.lang)}/`)}>
                  {post.data.title}
                </a>
              </h2>
              {post.data.description && <p>{post.data.description}</p>}
            </article>
          );
        })}
        </div>
      </div>
    </section>
  )}


  <!-- DEEP WATER -->

  <section
    class="
      home-section
      home-flow-section
    "
  >
    <div class="section-label">
      <span class="number">
        05
      </span>

      <span>
        {copy.apps}
      </span>
    </div>

    <div class="apps-layout">
      <h2>
        {
          featuredApp
            ? featuredApp.data.title
            : copy.appsFallback
        }
      </h2>

      <div class="side-copy">
        <p>
          {copy.appsCopy}
        </p>

        <a href={localizedPath('/apps/')}>
          {copy.exploreApps}
        </a>
      </div>
    </div>
  </section>


  <!-- NEWSLETTER -->

  <section
    class="
      newsletter
      home-flow-section
    "
    id="subscribe"
  >
    <div>
      <div class="section-label">
        <span class="number">
          06
        </span>

        <span>
          {copy.newsletter}
        </span>
      </div>

      <h2>
        {copy.newsletterTitle.split('\n').map((line, index) => (
          <>{index > 0 && <br />}{line}</>
        ))}
      </h2>
    </div>

    <div class="newsletter-right">
      <p>
        {copy.newsletterCopy}
      </p>

      <script
        is:inline
        src="https://f.convertkit.com/ckjs/ck.5.js"
      ></script>

      <form
        action="https://app.kit.com/forms/9892931/subscriptions"
        class="newsletter-form seva-form formkit-form"
        method="post"
        data-sv-form="9892931"
        data-uid="70f768a3ff"
        data-format="inline"
        data-version="5"
      >
        <ul
          class="formkit-alert formkit-alert-error"
          data-element="errors"
          data-group="alert"
        ></ul>

        <div
          class="newsletter-fields"
          data-element="fields"
          data-stacked="false"
        >
          <div class="newsletter-field">
            <label
              class="visually-hidden"
              for="newsletter-email"
            >
              {copy.emailLabel}
            </label>

            <input
              id="newsletter-email"
              class="formkit-input newsletter-input"
              name="email_address"
              type="email"
              placeholder={copy.emailPlaceholder}
              aria-label={copy.emailLabel}
              autocomplete="email"
              required
            />
          </div>

          <button
            class="formkit-submit newsletter-submit"
            type="submit"
            data-element="submit"
          >
            <span>
              {copy.subscribe}
            </span>
          </button>
        </div>

      </form>

      <p class="newsletter-note">
        {copy.newsletterNote}
      </p>
    </div>
  </section>


  <!-- ABYSS -->

  <section
    class="
      home-section
      home-flow-section
      about-section
    "
  >
    <div class="section-label">
      <span class="number">
        07
      </span>

      <span>
        {copy.about}
      </span>
    </div>

    <div class="about-layout">
      <h2>
        {copy.aboutTitle.split('\n').map((line, index) => (
          <>{index > 0 && <br />}{line}</>
        ))}
      </h2>

      <div class="side-copy">
        <p>
          {copy.aboutCopyOne}
        </p>

        <p>
          {copy.aboutCopyTwo}
        </p>

        <a href={localizedPath('/about/')}>
          {copy.aboutJack}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const frame = carousel.querySelector<HTMLElement>('.media-rail-frame');
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const controls = carousel.querySelector<HTMLElement>('.media-rail-controls');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-carousel-direction="previous"]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-direction="next"]');
    if (!frame || !track || !controls || !previous || !next) return;

    const updateControls = () => {
      const overflow = track.scrollWidth > track.clientWidth + 2;
      controls.hidden = !overflow;
      frame.classList.toggle('has-controls', overflow);
      const canGoPrevious = overflow && track.scrollLeft > 2;
      const canGoNext = overflow && track.scrollLeft + track.clientWidth < track.scrollWidth - 2;
      previous.disabled = !canGoPrevious;
      next.disabled = !canGoNext;
      track.classList.toggle('fade-left', canGoPrevious);
      track.classList.toggle('fade-right', canGoNext);
    };

    const move = (direction: number) => {
      const card = track.querySelector<HTMLElement>('.media-rail-item');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const distance = (card?.getBoundingClientRect().width ?? track.clientWidth) + gap;
      track.scrollBy({
        left: direction * distance,
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    };

    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', updateControls, { passive: true });
    new ResizeObserver(updateControls).observe(track);
    updateControls();
  });
</script>


<style is:global>
  /*
    HERO / SURFACE
  */

  .home-hero {
    min-height: 84vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: 64px;
    background:
      linear-gradient(
        90deg,
        rgba(1, 7, 13, 0.72) 0%,
        rgba(1, 7, 13, 0.46) 38%,
        rgba(1, 7, 13, 0.18) 68%,
        rgba(1, 7, 13, 0.12) 100%
      );
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #e0e5eb;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.9);
  }

  .home-hero h1 {
    max-width: 1120px;
    margin: 80px 0 72px;
    text-shadow: 0 6px 46px rgba(0, 0, 0, 0.92);
  }

  .hero-bottom {
    display: grid;
    grid-template-columns: minmax(0, 580px) auto;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
  }

  .hero-bottom p {
    margin: 0;
    color: #f0f2f5;
    font-size: 1.14rem;
    line-height: 1.75;
    text-shadow: 0 3px 22px rgba(0, 0, 0, 0.95);
  }

  .hero-bottom a {
    font-weight: 700;
    text-shadow: 0 3px 22px rgba(0, 0, 0, 0.95);
  }

  /*
    EDITORIAL FLOW
  */

  .home-flow-section {
    position: relative;
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding: 84px 24px;
  }

  .home-flow-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent 0%,
        rgba(220, 230, 240, 0.08) 12%,
        rgba(220, 230, 240, 0.18) 50%,
        rgba(220, 230, 240, 0.08) 88%,
        transparent 100%
      );
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 58px;
    color: #cbd4dd;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .number {
    display: inline-block;
    width: 30px;
  }

  .section-label-link {
    justify-content: space-between;
  }

  .section-label-link > div {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .section-label-link > a {
    color: var(--text);
    letter-spacing: 0;
    text-transform: none;
  }

  /*
    FEATURED JOURNAL
  */

  .featured-content h2 {
    max-width: 1050px;
    margin-bottom: 72px;
  }

  .featured-bottom {
    display: grid;
    grid-template-columns: minmax(0, 580px) auto;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
  }

  .featured-bottom p {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .featured-bottom a {
    font-weight: 700;
  }

  /*
    JOURNAL LIST
  */

  .journal-list {
    position: relative;
    padding-top: 1px;
  }

  .journal-list::before,
  .journal-row:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent 0%,
        rgba(220, 230, 240, 0.06) 10%,
        rgba(220, 230, 240, 0.14) 50%,
        rgba(220, 230, 240, 0.06) 90%,
        transparent 100%
      );
  }

  .journal-list::before {
    top: 0;
  }

  .journal-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 34px 0;
  }

  .journal-row:not(:last-child)::after {
    bottom: 0;
  }

  .journal-row:hover {
    color: var(--accent);
  }

  .journal-row h3 {
    margin-bottom: 0;
  }

  .post-date {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .arrow {
    color: var(--muted);
    font-size: 1.8rem;
  }

  /*
    PODCAST / YOUTUBE RAILS
  */

  .media-section-heading {
    display: block;
  }

  .media-rail-frame {
    position: relative;
  }

  .media-rail-controls[hidden] {
    display: none;
  }

  .media-rail-controls button {
    width: 52px;
