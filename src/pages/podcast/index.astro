---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';

const posts = (await getCollection('podcast'))
  .filter((post) => !post.data.draft && post.data.lang === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={isKorean ? '팟캐스트 — Jack' : 'Podcast — Jack'}
  description={isKorean ? '아이디어를 더 깊이 탐구하는 대화.' : 'Conversations and deeper explorations of ideas.'}
  {lang}
  alternatePath={isKorean ? '/podcast/' : '/ko/podcast/'}
>
  <section class="page-intro">
    <p class="eyebrow">{isKorean ? '팟캐스트' : 'Podcast'}</p>

    <h1>{isKorean ? '팟캐스트' : 'Podcast'}</h1>

    <p class="intro-copy">
      {isKorean
        ? '더 발전시킬 가치가 있는 아이디어를 대화로 깊이 탐구합니다.'
        : 'Conversations and deeper explorations of ideas worth taking further.'}
    </p>
  </section>

  <section class="content-section">
    {posts.length > 0 ? (
      <div class="podcast-list">
        {posts.map((post) => (
          <article class="podcast-item">
            <div>
              <p class="meta">
                {post.data.episode
                  ? `${isKorean ? '에피소드' : 'Episode'} ${post.data.episode} · `
                  : ''}

                {post.data.date.toLocaleDateString(dateLocale, {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>

              <h2>
                <a href={`${pathPrefix}/podcast/${post.id}/`}>
                  {post.data.title}
                </a>
              </h2>

              {post.data.description && (
                <p class="description">
                  {post.data.description}
                </p>
              )}
            </div>

            <a
              class="read-link"
              href={`${pathPrefix}/podcast/${post.id}/`}
            >
              {isKorean ? '듣기 →' : 'Listen →'}
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty">
        {isKorean ? '아직 발행된 팟캐스트가 없습니다.' : 'No published podcast episodes yet.'}
      </p>
    )}
  </section>
</BaseLayout>

<style is:global>
  .page-intro {
    padding: 90px 64px;
    margin-top: 24px;

    border: 1px solid var(--line);
    background: rgba(1, 8, 15, 0.62);
  }

  .page-intro h1 {
    margin-bottom: 36px;
  }

  .intro-copy {
    max-width: 620px;
    margin-bottom: 0;

    color: var(--muted);
    font-size: 1.1rem;
  }

  .content-section {
    padding: 70px 64px;
    margin-top: 24px;

    border: 1px solid var(--line);
    background: rgba(1, 8, 15, 0.68);
  }

  .podcast-list {
    border-top: 1px solid var(--line);
  }

  .podcast-item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;

    gap: 50px;

    padding: 42px 0;

    border-bottom: 1px solid var(--line);
  }

  .podcast-item h2 {
    max-width: 900px;
    margin-bottom: 18px;
  }

  .meta {
    margin-bottom: 16px;

    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .description {
    max-width: 700px;
    margin-bottom: 0;

    color: var(--muted);
    font-size: 1.05rem;
  }

  .read-link {
    font-weight: 700;
    white-space: nowrap;
  }

  .empty {
    margin-bottom: 0;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .page-intro,
    .content-section {
      padding: 40px 22px;
    }

    .podcast-item {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 22px;
    }
  }
</style>
