---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/editorial.css';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';

const posts = (await getCollection('podcast'))
  .filter((post) => !post.data.draft && post.data.lang === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={isKorean ? '팟캐스트 — Jack' : 'Podcast — Jack'}
  description={
    isKorean
      ? '생각을 대화로 발전시키는 팟캐스트입니다.'
      : 'Conversations that give ideas more room to develop.'
  }
  {lang}
  alternatePath={isKorean ? '/podcast/' : '/ko/podcast/'}
>
  <section class="editorial-intro">
    <p class="eyebrow">{isKorean ? '대화' : 'Conversation'}</p>

    <h1>{isKorean ? '팟캐스트' : 'Podcast'}</h1>

    <p class="muted">
      {isKorean
        ? '생각을 조금 더 오래 붙잡고 이야기합니다.'
        : 'Conversations that give ideas more room to breathe.'}
    </p>
  </section>

  <section class="editorial-list-section">
    {posts.length > 0 ? (
      <div class="editorial-list">
        {posts.map((post) => (
          <article class="editorial-entry">
            <p class="eyebrow">
              {post.data.date.toLocaleDateString(dateLocale, {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>

            <h2>
              <a href={`${pathPrefix}/podcast/${post.id}/`}>
                {post.data.title}
              </a>
            </h2>

            {post.data.description && (
              <p class="muted entry-description">
                {post.data.description}
              </p>
            )}

            <a
              class="text-link"
              href={`${pathPrefix}/podcast/${post.id}/`}
            >
              {isKorean ? '듣기' : 'Listen'} →
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">
        {isKorean
          ? '아직 발행된 팟캐스트가 없습니다.'
          : 'No published podcast episodes yet.'}
      </p>
    )}
  </section>
</BaseLayout>
