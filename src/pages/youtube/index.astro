---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/editorial.css';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';

const posts = (await getCollection('youtube'))
  .filter((post) => !post.data.draft && post.data.lang === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={isKorean ? '유튜브 — Jack' : 'YouTube — Jack'}
  description={
    isKorean
      ? '아이디어를 영상으로 발전시킵니다.'
      : 'Ideas developed through video.'
  }
  {lang}
  alternatePath={isKorean ? '/youtube/' : '/ko/youtube/'}
>
  <section class="editorial-intro">
    <p class="eyebrow">{isKorean ? '영상' : 'Video'}</p>

    <h1>{isKorean ? '유튜브' : 'YouTube'}</h1>

    <p class="muted">
      {isKorean
        ? '글과 생각을 다른 방식으로 바라봅니다.'
        : 'Another way to explore the ideas behind the writing.'}
    </p>
  </section>

  <section class="editorial-list-section">
    {posts.length > 0 ? (
      <div class="editorial-list">
        {posts.map((post) => (
          <article class="editorial-entry">
            <p class="eyebrow">
              {post.data.date.toLocaleDateString(dateLocale, {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>

            <h2>
              <a href={`${pathPrefix}/youtube/${post.id}/`}>
                {post.data.title}
              </a>
            </h2>

            {post.data.description && (
              <p class="muted entry-description">
                {post.data.description}
              </p>
            )}

            <a
              class="text-link"
              href={`${pathPrefix}/youtube/${post.id}/`}
            >
              {isKorean ? '보기' : 'Watch'} →
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">
        {isKorean
          ? '아직 발행된 영상이 없습니다.'
          : 'No published videos yet.'}
      </p>
    )}
  </section>
</BaseLayout>
