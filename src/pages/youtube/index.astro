---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';

const videos = (await getCollection('youtube'))
  .filter((video) => !video.data.draft && video.data.lang === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={isKorean ? '유튜브 — Jack' : 'YouTube — Jack'}
  description={isKorean ? '아이디어를 영상과 시각 자료로 탐구합니다.' : 'Videos and visual explorations of ideas.'}
  {lang}
  alternatePath={isKorean ? '/youtube/' : '/ko/youtube/'}
>
  <section class="page-intro">
    <p class="eyebrow">{isKorean ? '유튜브' : 'YouTube'}</p>

    <h1>{isKorean ? '유튜브' : 'YouTube'}</h1>

    <p class="intro-copy">
      {isKorean
        ? '시각적 설명, 실험, 그리고 형태를 갖춰 가는 아이디어입니다.'
        : 'Visual explanations, experiments and ideas taking shape.'}
    </p>
  </section>

  <section class="content-section">
    {videos.length > 0 ? (
      <div class="video-list">
        {videos.map((video) => (
          <article class="video-item">
            <div>
              <p class="meta">
                {video.data.date.toLocaleDateString(dateLocale, {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>

              <h2>
                <a href={`${pathPrefix}/youtube/${video.id}/`}>
                  {video.data.title}
                </a>
              </h2>

              {video.data.description && (
                <p class="description">
                  {video.data.description}
                </p>
              )}
            </div>

            <a
              class="watch-link"
              href={`${pathPrefix}/youtube/${video.id}/`}
            >
              {isKorean ? '보기 →' : 'Watch →'}
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty">
        {isKorean ? '아직 발행된 영상이 없습니다.' : 'No published YouTube videos yet.'}
      </p>
    )}
  </section>
</BaseLayout>

<style is:global>
  .page-intro {
    padding: 90px 64px;
    margin-top: 24px;

    border: 1px solid var(--line);

    background:
      linear-gradient(
        90deg,
        rgba(1, 8, 15, 0.72),
        rgba(1, 8, 15, 0.4)
      );
  }

  .page-intro h1 {
    margin-bottom: 36px;
  }

  .intro-copy {
    max-width: 620px;
    margin-bottom: 0;

    color: var(--muted);
    font-size: 1.1rem;
  }

  .content-section {
    padding: 70px 64px;
    margin-top: 24px;

    border: 1px solid var(--line);
    background: rgba(1, 8, 15, 0.72);
  }

  .video-list {
    border-top: 1px solid var(--line);
  }

  .video-item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;

    gap: 50px;

    padding: 42px 0;

    border-bottom: 1px solid var(--line);
  }

  .video-item h2 {
    max-width: 900px;
    margin-bottom: 18px;
  }

  .meta {
    margin-bottom: 16px;

    color: var(--muted);

    font-size: 0.82rem;

    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .description {
    max-width: 700px;
    margin-bottom: 0;

    color: var(--muted);
    font-size: 1.05rem;
  }

  .watch-link {
    font-weight: 700;
    white-space: nowrap;
  }

  .empty {
    margin-bottom: 0;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .page-intro,
    .content-section {
      padding: 40px 22px;
    }

    .video-item {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 22px;
    }
  }
</style>
