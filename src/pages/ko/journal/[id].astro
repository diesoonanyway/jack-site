---
import { getCollection } from 'astro:content';
import { getPublicSlug } from '../../../lib/content-slug';
import JournalDetail from '../../journal/[id].astro';

export async function getStaticPaths() {
  const posts = await getCollection('journal');

  return posts
    .filter((post) => !post.data.draft && post.data.lang === 'ko')
    .map((post) => ({
      params: { id: getPublicSlug(post.id, post.data.lang) },
      props: { post },
    }));
}

const { post } = Astro.props;
---

<JournalDetail post={post} lang="ko" />
