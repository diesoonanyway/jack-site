---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicSlug } from '../../lib/content-slug';
import '../../styles/editorial.css';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';

const posts = (await getCollection('journal'))
  .filter((post) => !post.data.draft && post.data.lang === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Journal — Jack"
  description={isKorean ? '에세이, 아이디어 그리고 유용한 글.' : 'Essays, ideas and useful writing.'}
  {lang}
  alternatePath={isKorean ? '/journal/' : '/ko/journal/'}
>
  <section class="editorial-intro">
    <h1>Journal</h1>

    <p class="muted">
      {isKorean
        ? '발전시킬 가치가 있는 에세이, 관찰 그리고 아이디어입니다.'
        : 'Essays, observations and ideas worth developing.'}
    </p>
  </section>

  <section class="editorial-list-section">
    {posts.length > 0 ? (
      <div class="editorial-list">
        {posts.map((post) => (
          <article class="editorial-entry">
            <p class="eyebrow">
              {post.data.date.toLocaleDateString(dateLocale, {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>

            <h2>
              <a href={`${pathPrefix}/journal/${getPublicSlug(post.id, post.data.lang)}/`}>
                {post.data.title}
              </a>
            </h2>

            {post.data.description && (
              <p class="muted entry-description">
                {post.data.description}
              </p>
            )}

            <a
              class="text-link"
              href={`${pathPrefix}/journal/${getPublicSlug(post.id, post.data.lang)}/`}
            >
              {isKorean ? '읽기' : 'Read'} →
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p>{isKorean ? '아직 발행된 Journal 항목이 없습니다.' : 'No published journal entries yet.'}</p>
    )}
  </section>
</BaseLayout>
