---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortByCreatedAt } from '../../lib/content-sort';
import { getPublicSlug } from '../../lib/content-slug';
import '../../styles/editorial.css';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const pathPrefix = isKorean ? '/ko' : '';
const dateLocale = isKorean ? 'ko-KR' : 'en-AU';
const posts = sortByCreatedAt((await getCollection('stories'))
  .filter((post) => !post.data.draft && post.data.lang === lang));
---

<BaseLayout
  title={isKorean ? '스토리 — Jack' : 'Stories — Jack'}
  description={isKorean ? '글로 읽고, 듣고, 볼 수 있는 이야기.' : 'Stories to read, listen to and watch.'}
  {lang}
  alternatePath={isKorean ? '/stories/' : '/ko/stories/'}
>
  <section class="editorial-intro">
    <h1>{isKorean ? '스토리' : 'Stories'}</h1>
    <p class="muted">
      {isKorean ? '읽고, 듣고, 볼 수 있는 이야기.' : 'Stories to read, listen to and watch.'}
    </p>
  </section>

  <section class="editorial-list-section">
    {posts.length > 0 ? (
      <div class="editorial-list">
        {posts.map((post) => (
          <article class="editorial-entry">
            <p class="eyebrow">
              {post.data.date.toLocaleDateString(dateLocale, {
                year: 'numeric', month: 'long', day: 'numeric',
              })}
            </p>
            <h2>
              <a href={`${pathPrefix}/stories/${getPublicSlug(post.id, post.data.lang)}/`}>
                {post.data.title}
              </a>
            </h2>
            {post.data.description && <p class="muted entry-description">{post.data.description}</p>}
            <a class="text-link" href={`${pathPrefix}/stories/${getPublicSlug(post.id, post.data.lang)}/`}>
              {isKorean ? '읽기' : 'Read'} →
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">{isKorean ? '아직 발행된 스토리가 없습니다.' : 'No published stories yet.'}</p>
    )}
  </section>
</BaseLayout>
