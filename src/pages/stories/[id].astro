---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicSlug } from '../../lib/content-slug';
import { getSafeExternalAudioUrl, getSpotifyEpisodeId, getSpotifyExternalUrl } from '../../lib/spotify';
import { getYouTubeThumbnailUrl, getYouTubeVideoId } from '../../lib/youtube';
import { createArticleStructuredData } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('stories');
  return posts
    .filter((post) => !post.data.draft && post.data.lang === 'en')
    .map((post) => ({
      params: { id: getPublicSlug(post.id, post.data.lang) },
      props: { post },
    }));
}

const { post, lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
const slug = getPublicSlug(post.id, post.data.lang);
const counterpart = (await getCollection('stories')).find((entry) =>
  !entry.data.draft && entry.data.lang !== lang &&
  getPublicSlug(entry.id, entry.data.lang) === slug
);
const alternatePath = counterpart
  ? `${isKorean ? '' : '/ko'}/stories/${slug}/`
  : undefined;
const spotifyId = getSpotifyEpisodeId(post.data.spotifyUrl);
const spotifyExternalUrl = getSpotifyExternalUrl(post.data.spotifyUrl);
const audioUrl = getSafeExternalAudioUrl(post.data.spotifyUrl);
const youtubeId = getYouTubeVideoId(post.data.youtubeUrl);
const youtubeThumbnail = getYouTubeThumbnailUrl(post.data.youtubeUrl);
const heroVisual = post.data.heroImage || youtubeThumbnail;
const storyDescription = post.data.intro || post.data.description;
const storyFormats = post.data.formats
  .map((format) => format.toUpperCase())
  .join(' · ');
const isWrittenArticle = post.data.formats.includes('read');
const seoDescription = post.data.description || post.data.title;
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const articleImageURL = post.data.heroImage && Astro.site
  ? new URL(post.data.heroImage, Astro.site).toString()
  : undefined;
const articleStructuredData = isWrittenArticle && canonicalURL
  ? createArticleStructuredData({
      title: post.data.title,
      description: seoDescription,
      datePublished: post.data.date.toISOString(),
      canonicalURL,
      lang,
      imageURL: articleImageURL,
    })
  : undefined;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — If It All Ends`}
  description={seoDescription}
  image={post.data.heroImage || undefined}
  type={isWrittenArticle ? 'article' : 'website'}
  publishedTime={isWrittenArticle ? post.data.date.toISOString() : undefined}
  structuredData={articleStructuredData}
  {lang}
  {alternatePath}
>
  <article class:list={['story-detail', { 'story-detail--text-only': !heroVisual }]}>
    {heroVisual && (
      <figure class="story-hero-visual">
        <img src={heroVisual} alt="" loading="eager" />
        {youtubeThumbnail && !post.data.heroImage && (
          <span class="story-play-cue" aria-hidden="true">▶</span>
        )}
      </figure>
    )}

    <header class:list={['story-detail-header', { 'story-detail-header--with-media': audioUrl || youtubeId }]}>
      <p class="story-formats">{storyFormats}</p>
      <h1 class="editorial-title">{post.data.title}</h1>
      {storyDescription && <p class="story-description">{storyDescription}</p>}
      <time class="story-date" datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString(isKorean ? 'ko-KR' : 'en-AU', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    </header>

    {(audioUrl || youtubeId) && (
      <div class="story-media">
        {audioUrl && (
          <section class="story-media-item">
            {spotifyId && (
              <div
                class="media-embed-placeholder media-embed-placeholder--spotify"
                data-media-embed
                data-media-kind="spotify"
                data-media-src={`https://open.spotify.com/embed/episode/${spotifyId}`}
                data-spotify-uri={`spotify:episode:${spotifyId}`}
                data-media-title={isKorean ? `${post.data.title} Spotify 재생기` : `${post.data.title} Spotify player`}
              >
                <button type="button" class="spotify-listen-button" data-media-load>
                  <span class="spotify-play-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M9 7.5v9l7-4.5-7-4.5Z"></path>
                    </svg>
                  </span>
                  <span>{isKorean ? '이 에피소드 듣기' : 'Listen to this episode'}</span>
                </button>
                <p class="media-privacy-note">
                  {isKorean
                    ? '불러오면 Spotify에 연결되며 기술 정보가 전달될 수 있습니다.'
                    : 'Loading connects to Spotify and may share technical information.'}
                </p>
              </div>
            )}
            <a class="media-external-link" href={audioUrl} target="_blank" rel="noopener noreferrer">
              {spotifyExternalUrl
                ? (isKorean ? 'Spotify에서 열기 →' : 'Open in Spotify →')
                : (isKorean ? '오디오 링크 열기 →' : 'Open audio link →')}
            </a>
          </section>
        )}

        {youtubeId && (
          <section class="story-media-item">
            <div class="video-embed">
              <div
                class="media-embed-placeholder media-embed-placeholder--youtube"
                data-media-embed
                data-media-kind="youtube"
                data-media-src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
                data-media-title={isKorean ? `${post.data.title} YouTube 영상` : `${post.data.title} YouTube video`}
              >
                <button type="button" class="media-load-button" data-media-load>
                  {isKorean ? 'YouTube 영상 불러오기' : 'Load YouTube video'}
                </button>
                <p class="media-privacy-note">
                  {isKorean
                    ? '불러오면 YouTube에 연결되며 기술 정보가 전달될 수 있습니다.'
                    : 'Loading connects to YouTube and may share technical information.'}
                </p>
              </div>
            </div>
            <a
              class="media-external-link"
              href={`https://www.youtube.com/watch?v=${youtubeId}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {isKorean ? 'YouTube에서 보기 →' : 'Watch on YouTube →'}
            </a>
          </section>
        )}
      </div>
    )}

    <div class="article-body"><Content /></div>
  </article>
</BaseLayout>

<script>
  type SpotifyEmbedController = {
    play: () => void;
  };

  type SpotifyIframeApi = {
    createController: (
      element: HTMLElement,
      options: { width: string; height: string; uri: string },
      callback: (controller: SpotifyEmbedController) => void,
    ) => void;
  };

  type SpotifyWindow = Window & {
    onSpotifyIframeApiReady?: (api: SpotifyIframeApi) => void;
    __ifitallendsSpotifyApi?: SpotifyIframeApi;
    __ifitallendsSpotifyApiPromise?: Promise<SpotifyIframeApi>;
  };

  const spotifyWindow = window as SpotifyWindow;

  const loadSpotifyApi = () => {
    if (spotifyWindow.__ifitallendsSpotifyApi) {
      return Promise.resolve(spotifyWindow.__ifitallendsSpotifyApi);
    }

    if (spotifyWindow.__ifitallendsSpotifyApiPromise) {
      return spotifyWindow.__ifitallendsSpotifyApiPromise;
    }

    spotifyWindow.__ifitallendsSpotifyApiPromise = new Promise((resolve, reject) => {
      spotifyWindow.onSpotifyIframeApiReady = (api) => {
        spotifyWindow.__ifitallendsSpotifyApi = api;
        resolve(api);
      };

      const existingScript = document.querySelector<HTMLScriptElement>('script[data-spotify-iframe-api]');
      if (existingScript) return;

      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://open.spotify.com/embed/iframe-api/v1';
      script.dataset.spotifyIframeApi = 'true';
      script.addEventListener('error', () => reject(new Error('Spotify iFrame API failed to load')), { once: true });
      document.body.append(script);
    });

    return spotifyWindow.__ifitallendsSpotifyApiPromise;
  };

  const createFallbackIframe = (placeholder: HTMLElement, src: string, title: string, kind: 'spotify' | 'youtube') => {
    const iframe = document.createElement('iframe');
    iframe.title = title;
    iframe.src = src;
    iframe.loading = 'lazy';
    iframe.allowFullscreen = true;

    if (kind === 'spotify') {
      iframe.width = '100%';
      iframe.height = '152';
      iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
    } else {
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    }

    placeholder.replaceWith(iframe);
  };

  document.querySelectorAll<HTMLElement>('[data-media-embed]').forEach((placeholder) => {
    const button = placeholder.querySelector<HTMLButtonElement>('[data-media-load]');
    const src = placeholder.dataset.mediaSrc;
    const title = placeholder.dataset.mediaTitle;
    const kind = placeholder.dataset.mediaKind;

    if (!button || !src || !title || (kind !== 'spotify' && kind !== 'youtube')) return;

    button.addEventListener('click', () => {
      if (kind === 'spotify') {
        const uri = placeholder.dataset.spotifyUri;
        if (!uri) return;

        button.disabled = true;
        placeholder.setAttribute('aria-busy', 'true');

        loadSpotifyApi()
          .then((api) => {
            const mount = document.createElement('div');
            mount.className = 'spotify-embed-mount';
            placeholder.replaceChildren(mount);
            placeholder.removeAttribute('aria-busy');

            api.createController(mount, {
              width: '100%',
              height: '152',
              uri,
            }, (controller) => controller.play());
          })
          .catch(() => createFallbackIframe(placeholder, src, title, 'spotify'));
      } else {
        createFallbackIframe(placeholder, src, title, 'youtube');
      }
    }, { once: true });
  });
</script>

<style>
  .story-detail {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding: 54px 32px 80px;
  }

  .story-hero-visual {
    position: relative;
    width: 100%;
    margin: 0 0 clamp(58px, 7vw, 96px);
    overflow: hidden;
    background: rgba(1, 8, 15, 0.48);
  }

  .story-hero-visual img {
    display: block;
    width: 100%;
    max-height: min(72vh, 760px);
    height: auto;
    object-fit: contain;
    margin-inline: auto;
  }

  .story-play-cue {
    position: absolute;
    right: 26px;
    bottom: 26px;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid rgba(246, 244, 239, 0.45);
    border-radius: 50%;
    color: var(--text);
    background: rgba(1, 8, 15, 0.72);
    font-size: 0.8rem;
    pointer-events: none;
  }

  .story-detail-header {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto clamp(68px, 8vw, 108px);
  }

  .story-detail--text-only .story-detail-header {
    padding-top: clamp(44px, 6vw, 80px);
  }

  .story-detail-header--with-media {
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .story-formats,
  .story-date {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .story-formats {
    margin-bottom: 30px;
  }

  .story-detail h1 {
    max-width: 1000px;
    margin-bottom: 32px;
    font-size: clamp(3.25rem, 5.2vw, 4.75rem);
    line-height: 1.04;
  }

  .story-description {
    max-width: 800px;
    margin-bottom: 30px;
    color: var(--body-text);
    font-size: clamp(1.12rem, 1.7vw, 1.32rem);
    line-height: 1.75;
  }

  .story-date {
    display: block;
    line-height: 1.6;
  }

  .media-external-link {
    color: var(--text);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(246, 244, 239, 0.34);
    text-underline-offset: 0.32em;
  }

  .media-external-link:focus-visible,
  .article-body :global(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }

  .story-media {
    width: 100%;
    max-width: 820px;
    margin: 0 auto clamp(56px, 7vw, 88px);
  }

  .story-media-item {
    padding-bottom: 36px;
    border-bottom: 1px solid rgba(220, 230, 240, 0.13);
  }

  .story-media-item + .story-media-item {
    padding-top: 36px;
  }

  .story-media-item :global(iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
  }

  .media-embed-placeholder {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 12px;
    width: 100%;
    min-height: 152px;
    padding: 24px;
    border: 1px solid rgba(220, 230, 240, 0.13);
    border-radius: 12px;
    background: rgba(1, 8, 15, 0.48);
    text-align: center;
  }

  .video-embed .media-embed-placeholder {
    height: 100%;
    min-height: 0;
  }

  .media-embed-placeholder--spotify {
    justify-items: start;
    min-height: 96px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    text-align: left;
  }

  .spotify-listen-button {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 0;
    border: 0;
    color: var(--text);
    background: transparent;
    font: inherit;
    font-family: var(--font-editorial);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    cursor: pointer;
  }

  .spotify-listen-button:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .spotify-play-icon {
    display: grid;
    flex: 0 0 56px;
    width: 56px;
    height: 56px;
    place-items: center;
    border: 1px solid rgba(219, 234, 255, 0.38);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .spotify-play-icon svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  .spotify-listen-button:hover .spotify-play-icon {
    border-color: rgba(219, 234, 255, 0.68);
    background: rgba(255, 255, 255, 0.14);
    transform: scale(1.03);
  }

  .spotify-listen-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  :global(.spotify-embed-mount) {
    width: 100%;
    min-height: 152px;
  }

  .media-load-button {
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid rgba(219, 234, 255, 0.3);
    border-radius: 999px;
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .media-load-button:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .media-load-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .media-privacy-note {
    max-width: 52ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .media-external-link {
    display: inline-block;
    margin-top: 18px;
  }

  .video-embed {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .video-embed :global(iframe) {
    width: 100%;
    height: 100%;
  }

  .story-detail .article-body {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    color: var(--body-text);
    font-size: clamp(1.08rem, 1.25vw, 1.17rem);
    line-height: 1.9;
  }

  .story-detail .article-body :global(p) {
    margin-bottom: 1.7em;
  }

  .story-detail .article-body :global(h2),
  .story-detail .article-body :global(h3) {
    font-family: var(--font-editorial);
    font-weight: var(--editorial-title-weight);
    letter-spacing: var(--editorial-title-tracking);
  }

  .story-detail .article-body :global(h2) {
    margin: 2.5em 0 0.85em;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.1;
  }

  .story-detail .article-body :global(h3) {
    margin: 2.2em 0 0.8em;
    font-size: clamp(1.65rem, 3vw, 2.3rem);
    line-height: 1.18;
  }

  .story-detail .article-body :global(a) {
    text-decoration: underline;
    text-decoration-color: rgba(246, 244, 239, 0.38);
    text-underline-offset: 0.24em;
  }

  .story-detail .article-body :global(blockquote) {
    margin: clamp(42px, 6vw, 68px) 0;
    padding: 6px 0 6px clamp(22px, 4vw, 38px);
    border-left: 1px solid rgba(220, 230, 240, 0.34);
    color: #e4e8ec;
    font-family: var(--font-editorial);
    font-size: clamp(1.3rem, 2.3vw, 1.7rem);
    line-height: 1.65;
  }

  .story-detail .article-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .story-detail .article-body :global(ul),
  .story-detail .article-body :global(ol) {
    margin: 0 0 1.8em;
    padding-left: 1.4em;
  }

  .story-detail .article-body :global(li) {
    margin-bottom: 0.65em;
  }

  .story-detail .article-body :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: clamp(44px, 7vw, 72px) auto;
  }

  .story-detail .article-body :global(figure) {
    width: 100%;
    max-width: 100%;
    margin: clamp(44px, 7vw, 72px) 0;
  }

  .story-detail .article-body :global(figure img) {
    margin: 0;
  }

  .story-detail .article-body :global(figcaption) {
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .story-detail .article-body :global(pre) {
    max-width: 100%;
    margin: 2.5em 0;
    padding: 22px;
    overflow-x: auto;
    background: rgba(1, 8, 15, 0.62);
  }

  @media (max-width: 760px) {
    .story-detail {
      padding: 30px 18px 56px;
    }

    .story-hero-visual {
      margin-bottom: 52px;
    }

    .story-hero-visual img {
      max-height: none;
    }

    .story-play-cue {
      right: 16px;
      bottom: 16px;
      width: 44px;
      height: 44px;
    }

    .story-detail-header,
    .story-detail--text-only .story-detail-header {
      margin-bottom: 62px;
      padding-top: 28px;
    }

    .story-detail-header--with-media,
    .story-detail--text-only .story-detail-header--with-media {
      margin-bottom: 32px;
    }

    .story-detail h1 {
      margin-bottom: 26px;
      font-size: clamp(2.125rem, 10vw, 2.75rem);
      line-height: 1.06;
    }

    .story-description {
      font-size: 1.08rem;
    }

    .story-media {
      margin-bottom: 60px;
    }

    .story-media-item {
      padding-bottom: 30px;
    }

    .story-media-item + .story-media-item {
      padding-top: 30px;
    }

    .story-detail .article-body {
      font-size: 1.07rem;
      line-height: 1.82;
    }
  }
</style>
