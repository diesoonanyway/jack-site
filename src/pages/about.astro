---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — Jack"
  description="About Jack and the ideas behind this site."
>
  <section class="reading-width">
    <p class="eyebrow">About</p>

    <h1>About</h1>

    <p class="muted">
      I write about ideas, problems and things worth building.
    </p>
  </section>

  <section class="section">
    <div class="reading-width article-body">
      <p>
        This site is where I develop ideas through writing.
      </p>

      <p>
        Some ideas become conversations, videos or products.
      </p>

      <p>
        The writing comes first. Everything else grows from there.
      </p>
    </div>
  </section>
</BaseLayout>