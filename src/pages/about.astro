---
import BaseLayout from '../layouts/BaseLayout.astro';

const { lang = 'en' } = Astro.props;
const isKorean = lang === 'ko';
---

<BaseLayout
  title={isKorean ? '소개 — If It All Ends' : 'About — If It All Ends'}
  description={isKorean
    ? '조금 느려도 나답게 생각하고, 배우고, 기록하는 삶에 관하여.'
    : 'A slower life of thinking, learning and writing things down.'}
  {lang}
  alternatePath={isKorean ? '/about/' : '/ko/about/'}
>
  <div class="about-page">
    <article class="about-copy">
      {isKorean ? (
        <>
          <h1 class="about-opening">
            세상은 너무 빠르고,<br />
            인생은 너무 짧습니다.
          </h1>

          <div class="about-supporting">
            <p>
              남을 따라가다 끝내기보다<br />
              조금 느려도 나답게 살고 싶습니다.
            </p>

            <p>생각하고, 배우고, 기록하면서.</p>
          </div>

          <p class="about-closing">어차피 끝날 인생이라면.</p>
        </>
      ) : (
        <>
          <h1 class="about-opening">
            The world moves too fast,<br />
            and life is too short.
          </h1>

          <div class="about-supporting">
            <p>
              Rather than spend my life chasing others,<br />
              I'd rather move a little slower and live on my own terms.
            </p>

            <p>To think, to learn, and to write it all down.</p>
          </div>

          <p class="about-closing">If it all ends anyway...</p>
        </>
      )}
    </article>
  </div>
</BaseLayout>

<style>
  .about-page {
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding: clamp(58px, 8vw, 112px) 24px clamp(84px, 11vw, 150px);
  }

  .about-copy {
    width: 100%;
    max-width: 820px;
  }

  .about-opening {
    max-width: 800px;
    margin-bottom: 0;
    font-family: var(--font-editorial);
    font-size: clamp(2.8rem, 5.2vw, 4.8rem);
    font-weight: var(--editorial-title-weight);
    line-height: 1.08;
    letter-spacing: var(--editorial-title-tracking);
  }

  .about-supporting {
    max-width: 720px;
    margin-top: clamp(64px, 8vw, 96px);
    color: var(--body-text);
    font-size: clamp(1.08rem, 1.5vw, 1.22rem);
    line-height: 1.85;
  }

  .about-supporting p {
    margin-bottom: 0;
  }

  .about-supporting p + p {
    margin-top: 2.15em;
  }

  .about-closing {
    margin: 44px 0 0;
    color: var(--text);
    font-family: var(--font-editorial);
    font-size: clamp(1.4rem, 2.3vw, 1.9rem);
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  @media (max-width: 760px) {
    .about-page {
      padding: 42px 18px 78px;
    }

    .about-opening {
      font-size: clamp(2.1rem, 10.5vw, 3rem);
      line-height: 1.12;
    }

    .about-supporting {
      margin-top: 52px;
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .about-supporting p + p {
      margin-top: 1.9em;
    }

    .about-closing {
      margin-top: 32px;
      font-size: 1.4rem;
    }
  }
</style>
